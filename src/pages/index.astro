    /* =============================================================
       LIGHTBOX
    ============================================================= */

    body.lightbox-open {
        overflow:
            hidden;
    }

    .lightbox {
        position:
            fixed;
        inset:
            0;
        z-index:
            100;
        display:
            grid;
        place-items:
            center;
        visibility:
            hidden;
        opacity:
            0;
        pointer-events:
            none;
        transition:
            opacity 0.22s ease,
            visibility 0.22s ease;
    }

    .lightbox.is-open {
        visibility:
            visible;
        opacity:
            1;
        pointer-events:
            auto;
    }

    .lightbox-backdrop {
        position:
            absolute;
        inset:
            0;
        background:
            rgba(23, 23, 23, 0.9);
        backdrop-filter:
            blur(5px);
    }

    .lightbox-shell {
        position:
            relative;
        z-index:
            2;

        display:
            grid;

        grid-template-columns:
            68px minmax(0, 1fr) 68px;

        align-items:
            center;

        gap:
            10px;

        width:
            min(96vw, 1500px);

        max-height:
            94vh;
    }

    .lightbox-content {
        min-width:
            0;

        max-height:
            94vh;

        display:
            flex;

        flex-direction:
            column;

        align-items:
            center;

        justify-content:
            center;
    }

    .lightbox-image-wrap {
        position:
            relative;

        display:
            flex;

        align-items:
            center;

        justify-content:
            center;

        max-width:
            100%;

        max-height:
            calc(94vh - 78px);

        padding:
            10px;

        background:
            #fff8e8;

        border:
            2px solid #171717;

        border-radius:
            11px 16px 12px 15px;

        box-shadow:
            9px 10px 0 rgba(0, 0, 0, 0.16);
    }

    .lightbox-image-wrap img {
        display:
            block;

        width:
            auto;

        height:
            auto;

        max-width:
            min(82vw, 1280px);

        max-height:
            calc(94vh - 104px);

        object-fit:
            contain;
    }

    .lightbox-caption {
        display:
            flex;

        align-items:
            baseline;

        justify-content:
            center;

        gap:
            14px;

        padding-top:
            12px;

        color:
            #fff8e8;

