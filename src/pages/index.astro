        transform:
            rotate(var(--rotation));

        transform-origin:
            center center;

        transition:
            transform 0.28s
                cubic-bezier(
                    0.22,
                    0.61,
                    0.36,
                    1
                ),
            box-shadow 0.28s
                cubic-bezier(
                    0.22,
                    0.61,
                    0.36,
                    1
