---
import Layout from '../layouts/Layout.astro';
import { photoWorks } from '../data/photo';

/* =============================================================
   HOME IMAGE SOURCES

   01 / HERO：只手动指定这一张图。

   改这里的路径，即可更换首页 Hero 图片。
============================================================= */

const heroImage = '/photos/hero/20260918-001.png';

const heroId =
    heroImage.split('/').pop()?.replace(/\.[^.]+$/, '') ?? '';

const heroMatch =
    heroId.match(/^(\d{4})[-_](\d{2})[-_](\d{2})/);

const heroDate = heroMatch
    ? `${heroMatch[1]}-${heroMatch[2]}-${heroMatch[3]}`
    : '';

/* =============================================================
   02 / EXHIBITION：沿用 Exhibition 的完整作品列表。

   首页默认取最新 6 张；Admin 修改DATE后，前端也会同步最新排序。
============================================================= */

const latestSixWorks = photoWorks.slice(0, 6);

const homeCardClasses = [
    'work-card-large',
    'work-card-small work-card-offset',
    'work-card-small',
    'work-card-large',
    'work-card-large work-card-lower',
    'work-card-small work-card-lower-offset',
];

const homePaperClasses = [
    'paper-default',
    'paper-blue',
    'paper-red',
    'paper-green',
    'paper-yellow',
    'paper-purple',
];

const homeTapeClasses = [
    'tape-card-left',
    'tape-card-right',
    '',
    'tape-card-left',
    'tape-card-right',
    '',
];


---

<Layout
    title="Roco Photo Gallery"
    description="A ROCOal exhibition of game photography."
>
    <div class="page">

        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->

        <header class="site-header">
            <a
                href="/"
                class="brand"
                aria-label="Roco Photo Gallery"
            >
                <span class="brand-name">ROCO</span>
                <span class="brand-caption">
                    GAME PHOTOGRAPHY
                </span>
            </a>

            <nav
                class="top-nav"
                aria-label="Main navigation"
            >
                <a href="/exhibition">Exhibition</a>
                <a href="#about">About</a>
            </nav>
        </header>


        <!-- ========================================================= -->
        <!-- HERO -->
        <!-- ========================================================= -->

        <main>
            <section
                class="hero"
                aria-labelledby="hero-title"
            >
                <div class="hero-topline">
                    <span>01</span>
                    <span>TODAY'S BEST MOMENT</span>
                    <span>ROCO PHOTOGALLERY</span>
                </div>

                <div class="hero-layout">

                    <div class="hero-copy">

                        <div class="sticker-mini">
                            洛克街拍记录
                        </div>

                        <h1 id="hero-title">
                            今日瞬间！
                            <br />
                            Today 's
                            <br />
                            Moment
                        </h1>

                        <p class="hero-description">
                            感谢每一位光顾的小洛克，因为那些透过镜头和你们视线交汇的瞬间，
                            洛克王国于我的意义添了一笔又一笔，希望于你们也是~
                        </p>

                        <a
                            class="enter-link"
                            href="/exhibition"
                        >
                            <span class="enter-link-label">
                                ENTER EXHIBITION
                            </span>

                            <span
                                class="enter-link-arrow"
                                aria-hidden="true"
                            >
                                ↓
                            </span>
                        </a>

                    </div>


                    <div class="hero-art">

                        <div class="tape tape-top"></div>

                        <div class="photo-paper">

                            <div class="photo-frame">

                                <button
                                    type="button"
                                    class="lightbox-trigger lightbox-trigger-hero"
                                    data-lightbox-group="hero"
                                    data-lightbox-src={heroImage}
                                    data-lightbox-alt="Featured game photography"
                                    data-lightbox-title="今日瞬间"
                                    data-lightbox-date={heroDate}
                                    aria-label="View featured photo"
                                >
                                    <div class="photo-placeholder hero-photo">

                                        <img
                                            src={heroImage}
                                            alt="Featured game photography"
                                            loading="eager"
                                            decoding="async"
                                        />

                                    </div>
                                </button>


                                <div class="photo-note">

                                    <div>
                                        <strong>
                                            今日瞬间
                                        </strong>

                                        <span>
                                            {heroDate}
                                        </span>
                                    </div>

                                    <span class="photo-number">
                                        01 / 24
                                    </span>

                                </div>

                            </div>
                        </div>


                        <div
                            class="doodle doodle-star"
                            aria-hidden="true"
                        >
                            ✦
                        </div>

                        <div
                            class="doodle doodle-circle"
                            aria-hidden="true"
                        ></div>

                    </div>

                </div>


                <div class="hero-bottomline">
                    <span>NEW</span>
                    <span>SCROLL TO EXPLORE</span>
                </div>

            </section>


            <!-- ===================================================== -->
            <!-- EXHIBITION -->
            <!-- ===================================================== -->

            <section
                id="exhibition"
                class="exhibition"
                aria-labelledby="exhibition-title"
            >

                <div class="section-intro">

                    <div>

                        <span class="section-index">
                            02
                        </span>

                        <p class="section-kicker">
                            ROCO MOMENTS
                        </p>

                        <h2 id="exhibition-title">
                            Exhibition
                        </h2>

                    </div>

                    <p class="section-description"></p>

                </div>


                <div class="works-grid">

                    {latestSixWorks.map((work, index) => (

                        <article
                            class={`work-card ${homeCardClasses[index]}`}
                            data-home-slot={index + 1}
                            data-id={work.id}
                            data-date={work.date}
                        >

                            {homeTapeClasses[index] && (
                                <div
                                    class={`tape tape-card ${homeTapeClasses[index]}`}
                                ></div>
                            )}


                            <button
                                type="button"
                                class="lightbox-trigger work-image-link"
                                data-lightbox-group="works"
                                data-lightbox-index={index}
                                data-lightbox-src={work.image}
                                data-lightbox-alt={work.id}
                                data-lightbox-date={work.date}
                                aria-label={`View ${work.id}`}
                            >

                                <div
                                    class={`paper-backdrop ${homePaperClasses[index]}`}
                                >

                                    <div
                                        class={`photo-placeholder photo-${index + 1}`}
                                    >

                                        <img
                                            src={work.image}
                                            alt={work.id}
                                            loading="lazy"
                                            decoding="async"
                                        />

                                        <span class="photo-index">
                                            {String(index + 1).padStart(
                                                2,
                                                '0',
                                            )}
                                        </span>

                                    </div>

                                </div>

                            </button>


                            <div class="work-caption">

                                <div>

                                </div>

                                <time
                                    class="home-work-date"
                                    datetime={work.date}
                                >
                                    {work.date.slice(0, 4)}
                                </time>

                            </div>

                        </article>

                    ))}

                </div>


                <div class="works-more">

                    <a href="/exhibition">

                        <span>
                            VIEW ALL PHOTOS
                        </span>

                        <span aria-hidden="true">
                            ↗
                        </span>

                    </a>

                </div>

            </section>


            <!-- ===================================================== -->
            <!-- LIGHTBOX -->
            <!-- ===================================================== -->

            <div
                class="lightbox"
                id="lightbox"
                aria-hidden="true"
                role="dialog"
                aria-modal="true"
                aria-label="Image viewer"
            >

                <div
                    class="lightbox-backdrop"
                    data-lightbox-close
                ></div>


                <div class="lightbox-shell">

                    <!-- CLOSE -->

                    <button
                        type="button"
                        class="lightbox-close"
                        id="lightbox-close"
                        aria-label="Close image viewer"
                    >
                        ×
                    </button>


                    <!-- PREVIOUS -->

                    <button
                        type="button"
                        class="lightbox-arrow lightbox-prev"
                        id="lightbox-prev"
                        aria-label="Previous photo"
                    >
                        <svg
                            class="lightbox-arrow-icon"
                            viewBox="0 0 48 80"
                            aria-hidden="true"
                            focusable="false"
                        >
                            <path
                                d="M42 5 L7 40 L42 75 L42 56 L26 40 L42 24 Z"
                            />
                        </svg>
                    </button>


                    <!-- CONTENT -->

                    <div class="lightbox-content">

                        <div class="lightbox-image-wrap">

                            <img
                                id="lightbox-image"
                                src=""
                                alt=""
                            />

                        </div>


                        <div class="lightbox-caption">

                            <strong
                                id="lightbox-title"
                            ></strong>

                            <span
                                id="lightbox-date"
                            ></span>

                            <span
                                id="lightbox-counter"
                            ></span>

                        </div>

                    </div>


                    <!-- NEXT -->

                    <button
                        type="button"
                        class="lightbox-arrow lightbox-next"
                        id="lightbox-next"
                        aria-label="Next photo"
                    >
                        <svg
                            class="lightbox-arrow-icon"
                            viewBox="0 0 48 80"
                            aria-hidden="true"
                            focusable="false"
                        >
                            <path
                                d="M6 5 L41 40 L6 75 L6 56 L22 40 L6 24 Z"
                            />
                        </svg>
                    </button>

                </div>

            </div>

        </main>


        <!-- ========================================================= -->
        <!-- ABOUT -->
        <!-- ========================================================= -->

        <section
            id="about"
            class="about"
        >

            <div
                class="about-decor"
                aria-hidden="true"
            >

                <div class="about-circle"></div>

                <div class="about-cross">
                    +
                </div>

            </div>


            <div class="about-index">
                03
            </div>


            <div class="about-content">

                <p class="section-kicker">
                    ABOUT THE EXHIBITION
                </p>

                <h2>
                    RocoKingdom
                    <br />
                    Moments
                </h2>

                <p class="about-copy">
                    每晚都会在商店街出没，欢迎来玩~我的学号是168225024 :D
                </p>

            </div>

        </section>


        <!-- ========================================================= -->
        <!-- FOOTER -->
        <!-- ========================================================= -->

        <footer class="footer">

            <div class="footer-brand">

                <span>
                    ROCO
                </span>

                <small>
                    GAME PHOTOGRAPHY
                </small>

            </div>


            <div class="footer-note">

                <span>
                    ROCOAL ARCHIVE
                </span>

                <span>
                    © 2026
                </span>

            </div>

        </footer>

    </div>
</Layout>


<script define:vars={{ photoWorks }}>

    const STORAGE_KEY =
        'roco-photo-admin-draft-v1';

    let lightboxItems = [];

    let lightboxIndex = 0;

    let lastFocusedElement = null;

    let touchStartX = 0;


    /* =============================================================
       STORAGE
    ============================================================= */

    function readStore() {

        try {

            const raw =
                localStorage.getItem(
                    STORAGE_KEY,
                );

            if (!raw) {
                return {};
            }

            const parsed =
                JSON.parse(raw);

            return parsed &&
                typeof parsed === 'object'
                ? parsed
                : {};

        } catch {

            return {};

        }

    }


    /* =============================================================
       GET LATEST 6
    ============================================================= */

    function getLatestSixWorks() {

        const store =
            readStore();

        return photoWorks
            .map((work) => ({

                ...work,

                date:
                    store[work.id]?.date ||
                    work.date,

            }))
            .sort(
                (a, b) =>
                    b.date.localeCompare(a.date) ||
                    b.id.localeCompare(a.id),
            )
            .slice(0, 6);

    }


    /* =============================================================
       SYNC HOME EXHIBITION
    ============================================================= */

    function syncHomeWorks() {

        const latestWorks =
            getLatestSixWorks();

        const homeCards =
            Array.from(
                document.querySelectorAll(
                    '[data-home-slot]',
                ),
            );


        homeCards.forEach(
            (card, index) => {

                const work =
                    latestWorks[index];

                if (!work) {
                    return;
                }


                const image =
                    card.querySelector('img');

                const date =
                    card.querySelector(
                        '.home-work-date',
                    );

                const trigger =
                    card.querySelector(
                        '.work-image-link',
                    );


                card.dataset.id =
                    work.id;

                card.dataset.date =
                    work.date;


                if (image) {

                    image.src =
                        work.image;

                    image.alt =
                        work.id;

                }


                if (date) {

                    date.setAttribute(
                        'datetime',
                        work.date,
                    );

                    date.textContent =
                        work.date.slice(0, 4);

                }


                if (trigger) {

                    trigger.dataset.lightboxSrc =
                        work.image;

                    trigger.dataset.lightboxAlt =
                        work.id;

                    trigger.dataset.lightboxDate =
                        work.date;

                }

            },
        );

    }


    /* =============================================================
       COLLECT WORK LIGHTBOX ITEMS
    ============================================================= */

    function collectLightboxItems() {

        const triggers =
            Array.from(
                document.querySelectorAll(
                    '.work-image-link[data-lightbox-group="works"]',
                ),
            );


        lightboxItems =
            triggers.map(
                (trigger) => ({

                    src:
                        trigger.dataset.lightboxSrc ||
                        '',

                    alt:
                        trigger.dataset.lightboxAlt ||
                        '',

                    title:
                        trigger.dataset.lightboxTitle ||
                        '',

                    date:
                        trigger.dataset.lightboxDate ||
                        '',

                }),
            );


        return triggers;

    }


    /* =============================================================
       UPDATE LIGHTBOX
    ============================================================= */

    function updateLightboxImage() {

        const lightbox =
            document.querySelector(
                '#lightbox',
            );

        const lightboxImage =
            document.querySelector(
                '#lightbox-image',
            );

        const lightboxTitle =
            document.querySelector(
                '#lightbox-title',
            );

        const lightboxDate =
            document.querySelector(
                '#lightbox-date',
            );

        const lightboxCounter =
            document.querySelector(
                '#lightbox-counter',
            );

        const lightboxPrevious =
            document.querySelector(
                '#lightbox-prev',
            );

        const lightboxNext =
            document.querySelector(
                '#lightbox-next',
            );


        if (
            !lightbox ||
            !lightboxImage
        ) {

            return;

        }


        const item =
            lightboxItems[
                lightboxIndex
            ];


        if (!item) {

            return;

        }


        lightboxImage.src =
            item.src;

        lightboxImage.alt =
            item.alt;


        if (lightboxTitle) {

            lightboxTitle.textContent =
                item.title;

        }


        if (lightboxDate) {

            lightboxDate.textContent =
                item.date;

        }


        if (lightboxCounter) {

            lightboxCounter.textContent =
                `${String(
                    lightboxIndex + 1,
                ).padStart(
                    2,
                    '0',
                )} / ${String(
                    lightboxItems.length,
                ).padStart(
                    2,
                    '0',
                )}`;

        }


        const hasMultiple =
            lightboxItems.length > 1;


        if (lightboxPrevious) {

            lightboxPrevious.hidden =
                !hasMultiple;

            lightboxPrevious.disabled =
                !hasMultiple;

        }


        if (lightboxNext) {

            lightboxNext.hidden =
                !hasMultiple;

            lightboxNext.disabled =
                !hasMultiple;

        }

    }


    /* =============================================================
       OPEN
    ============================================================= */

    function openLightbox(
        index,
        items,
    ) {

        const lightbox =
            document.querySelector(
                '#lightbox',
            );

        const lightboxClose =
            document.querySelector(
                '#lightbox-close',
            );


        if (
            !lightbox ||
            !items ||
            items.length === 0
        ) {

            return;

        }


        lastFocusedElement =
            document.activeElement instanceof
            HTMLElement
                ? document.activeElement
                : null;


        lightboxItems =
            items;


        lightboxIndex =
            Math.max(
                0,
                Math.min(
                    index,
                    items.length - 1,
                ),
            );


        updateLightboxImage();


        lightbox.classList.add(
            'is-open',
        );


        lightbox.setAttribute(
            'aria-hidden',
            'false',
        );


        document.body.classList.add(
            'lightbox-open',
        );


        lightboxClose?.focus();

    }


    /* =============================================================
       CLOSE
    ============================================================= */

    function closeLightbox() {

        const lightbox =
            document.querySelector(
                '#lightbox',
            );

        const lightboxImage =
            document.querySelector(
                '#lightbox-image',
            );


        if (!lightbox) {

            return;

        }


        lightbox.classList.remove(
            'is-open',
        );


        lightbox.setAttribute(
            'aria-hidden',
            'true',
        );


        document.body.classList.remove(
            'lightbox-open',
        );


        if (lightboxImage) {

            lightboxImage.removeAttribute(
                'src',
            );

            lightboxImage.alt =
                '';

        }


        lastFocusedElement?.focus();

        lastFocusedElement =
            null;

    }


    /* =============================================================
       PREVIOUS / NEXT
    ============================================================= */

    function showPrevious() {

        if (
            lightboxItems.length <= 1
        ) {

            return;

        }


        lightboxIndex =
            (
                lightboxIndex -
                1 +
                lightboxItems.length
            ) %
            lightboxItems.length;


        updateLightboxImage();

    }


    function showNext() {

        if (
            lightboxItems.length <= 1
        ) {

            return;

        }


        lightboxIndex =
            (
                lightboxIndex +
                1
            ) %
            lightboxItems.length;


        updateLightboxImage();

    }


    /* =============================================================
       CLICK

       使用 CAPTURE 阶段。
    ============================================================= */

    document.addEventListener(
        'click',
        (event) => {

            const target =
                event.target;


            if (
                !(target instanceof Element)
            ) {

                return;

            }


            /* -----------------------------------------------------
               1. 图片
            ----------------------------------------------------- */

            const trigger =
                target.closest(
                    '.lightbox-trigger',
                );


            if (trigger) {

                event.preventDefault();

                event.stopPropagation();


                const group =
                    trigger.dataset
                        .lightboxGroup ||
                    '';


                /* Exhibition 首页六张 */

                if (
                    group === 'works'
                ) {

                    const triggers =
                        collectLightboxItems();


                    const index =
                        triggers.indexOf(
                            trigger,
                        );


                    openLightbox(
                        index >= 0
                            ? index
                            : 0,
                        lightboxItems,
                    );


                    return;

                }


                /* Hero */

                openLightbox(
                    0,
                    [
                        {
                            src:
                                trigger.dataset
                                    .lightboxSrc ||
                                '',

                            alt:
                                trigger.dataset
                                    .lightboxAlt ||
                                '',

                            title:
                                trigger.dataset
                                    .lightboxTitle ||
                                '',

                            date:
                                trigger.dataset
                                    .lightboxDate ||
                                '',
                        },
                    ],
                );


                return;

            }


            /* -----------------------------------------------------
               2. 关闭
            ----------------------------------------------------- */

            if (
                target.closest(
                    '#lightbox-close',
                )
            ) {

                event.preventDefault();

                closeLightbox();

                return;

            }


            /* -----------------------------------------------------
               3. 上一张
            ----------------------------------------------------- */

            if (
                target.closest(
                    '#lightbox-prev',
                )
            ) {

                event.preventDefault();

                showPrevious();

                return;

            }


            /* -----------------------------------------------------
               4. 下一张
            ----------------------------------------------------- */

            if (
                target.closest(
                    '#lightbox-next',
                )
            ) {

                event.preventDefault();

                showNext();

                return;

            }


            /* -----------------------------------------------------
               5. 黑色背景关闭
            ----------------------------------------------------- */

            if (
                target.closest(
                    '[data-lightbox-close]',
                )
            ) {

                event.preventDefault();

                closeLightbox();

            }

        },
        true,
    );


    /* =============================================================
       KEYBOARD
    ============================================================= */

    document.addEventListener(
        'keydown',
        (event) => {

            const lightbox =
                document.querySelector(
                    '#lightbox',
                );


            if (
                !lightbox?.classList.contains(
                    'is-open',
                )
            ) {

                return;

            }


            if (
                event.key === 'Escape'
            ) {

                event.preventDefault();

                closeLightbox();

                return;

            }


            if (
                event.key === 'ArrowLeft'
            ) {

                event.preventDefault();

                showPrevious();

                return;

            }


            if (
                event.key === 'ArrowRight'
            ) {

                event.preventDefault();

                showNext();

            }

        },
    );


    /* =============================================================
       MOBILE SWIPE
    ============================================================= */

    document.addEventListener(
        'touchstart',
        (event) => {

            const lightbox =
                document.querySelector(
                    '#lightbox',
                );


            if (
                !lightbox?.classList.contains(
                    'is-open',
                )
            ) {

                return;

            }


            touchStartX =
                event.changedTouches[0]
                    ?.clientX ||
                0;

        },
        {
            passive: true,
        },
    );


    document.addEventListener(
        'touchend',
        (event) => {

            const lightbox =
                document.querySelector(
                    '#lightbox',
                );


            if (
                !lightbox?.classList.contains(
                    'is-open',
                )
            ) {

                return;

            }


            const endX =
                event.changedTouches[0]
                    ?.clientX ||
                0;


            const deltaX =
                endX -
                touchStartX;


            if (
                Math.abs(deltaX) < 50
            ) {

                return;

            }


            if (
                deltaX < 0
            ) {

                showNext();

            } else {

                showPrevious();

            }

        },
        {
            passive: true,
        },
    );


    /* =============================================================
       STORAGE SYNC
    ============================================================= */

    window.addEventListener(
        'storage',
        (event) => {

            if (
                event.key === STORAGE_KEY
            ) {

                syncHomeWorks();

            }

        },
    );


    window.addEventListener(
        'pageshow',
        () => {

            syncHomeWorks();

        },
    );


    document.addEventListener(
        'astro:page-load',
        () => {

            syncHomeWorks();

        },
    );


    /* =============================================================
       INITIALIZE
    ============================================================= */

    syncHomeWorks();

</script>


<style>

    /* =============================================================
       BASE
    ============================================================= */

    .page {
        position: relative;
        width: min(100%, 1440px);
        margin: 0 auto;
        padding: 0 42px;
        overflow: hidden;
    }

    .page::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 50;
        background-image:
            radial-gradient(
                rgba(32, 28, 16, 0.04) 0.55px,
                transparent 0.55px
            );
        background-size: 7px 7px;
        mix-blend-mode: multiply;
        opacity: 0.45;
    }

    .page::after {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 49;
        background:
            radial-gradient(
                circle at 15% 10%,
                rgba(255, 255, 255, 0.11),
                transparent 27%
            ),
            radial-gradient(
                circle at 84% 76%,
                rgba(255, 255, 255, 0.1),
                transparent 25%
            );
    }


    /* =============================================================
       HEADER
    ============================================================= */

    .site-header {
        position: relative;
        z-index: 10;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 30px 0 24px;
    }

    .brand {
        display: inline-flex;
        flex-direction: column;
        gap: 6px;
        text-decoration: none;
