            12px;

        font-weight:
            900;

        letter-spacing:
            -0.01em;
    }

    .lightbox-caption span {
        opacity:
            0.62;
    }


    /* =============================================================
       LIGHTBOX ARROWS
    ============================================================= */

    .lightbox-arrow {
        appearance:
            none !important;

        -webkit-appearance:
            none !important;

        position:
            relative;

        display:
            flex;

        align-items:
            center;

        justify-content:
            center;

        width:
            68px;

        height:
            96px;

        padding:
            0 !important;

        margin:
            0;

        border:
            0 !important;

        outline:
            none;

        background:
            transparent !important;

        color:
            transparent;

        cursor:
            pointer;

        box-shadow:
            none !important;

        border-radius:
            0 !important;

        overflow:
            visible;

        transition:
            transform 0.18s ease,
            opacity 0.18s ease;
    }


    .lightbox-arrow::before,
    .lightbox-arrow::after {
        content:
            none !important;

        display:
            none !important;
    }


    .lightbox-arrow-icon {
        display:
            block;

        width:
            48px;

        height:
            80px;

        margin:
            0;

        padding:
            0;

        overflow:
            visible;

        pointer-events:
            none;
    }


    .lightbox-arrow-icon path {
        fill:
            #fff8e8 !important;

        stroke:
            none !important;
    }


    .lightbox-prev:hover {
        transform:
            translateX(-5px);
    }


    .lightbox-next:hover {
        transform:
            translateX(5px);
    }


    .lightbox-arrow:disabled {
        opacity:
            0.18;

        cursor:
            default;

        transform:
            none;
    }


    .lightbox-arrow:focus-visible {
        outline:
            2px solid #fff8e8;

        outline-offset:
            8px;
    }


    .lightbox-close {
        appearance:
            none;

        -webkit-appearance:
            none;

        position:
            absolute;

        right:
            0;

        top:
            -8px;

