			7px 9px 6px 8px;

		overflow: hidden;
	}


	.filter-control
	input,
	.filter-control
	select {

		height: 100%;

		border: 0;

		outline: 0;

		background: transparent;

		color: #171717;

		font-size: 10px;

		font-weight: 900;

		letter-spacing:
			0.05em;

		appearance: none;
	}


	.filter-control
	select {

		width: 100%;

		padding:
			0 13px;

		cursor: pointer;
	}


	.filter-control:not(
		.date-control
	)::after {

		content: "⌄";

		position: absolute;

		right: 12px;

		top: 50%;

		font-size: 14px;

		line-height: 1;

		transform:
			translateY(-58%);

		pointer-events:
			none;
	}


	/* =============================================================
	   DATE
	============================================================= */

	.date-control {
		display: flex;

		align-items: center;

		overflow: visible;
	}


	.date-control::after {
		content: "";

		position: absolute;

		right: 12px;

		top: 50%;

		width: 10px;

		height: 10px;

		border:
			1.6px solid #171717;

		border-radius: 2px;

		transform:
			translateY(-50%);

		pointer-events: none;

		opacity: 0.75;
	}


	.date-control::before {
		content: "";

		position: absolute;

		right: 12px;

		top:
			calc(50% - 6px);

		width: 6px;

		height: 2px;

		background:
			#171717;

		pointer-events: none;

		opacity: 0.75;

		z-index: 1;
	}


	.date-segments {
		display: flex;

		align-items: center;

		gap: 0;

		height: 100%;

		padding-left: 13px;

		padding-right: 42px;
	}


	.date-segments input {
		width: auto;

		height: 100%;

		padding: 0;

		font-family:
			Arial,
			Helvetica,
			sans-serif;

		font-size: 10px;

		font-weight: 900;

		letter-spacing:
			0.03em;

		background: transparent;

		text-align: center;
	}


	.date-segments
	input::-webkit-inner-spin-button,
	.date-segments
	input::-webkit-outer-spin-button {

		margin: 0;

		appearance:
			none;
	}


	#date-year {
		width: 48px;
	}


	#date-month,
	#date-day {
		width: 31px;
	}


	.date-separator {
		display: inline-flex;

		align-items: center;

		justify-content: center;

		width: 10px;

		font-size: 10px;

		font-weight: 900;
	}


	.clear-filter {
		position: absolute;

		z-index: 2;

		right: 31px;

		top: 50%;

		display: flex;

		align-items: center;

		justify-content: center;

		width: 22px;

		height: 22px;

		padding: 0;

		border: 0;

		background:
			#171717;

		color:
			#fff8e8;

		border-radius: 50%;

		font-size: 14px;

		line-height: 1;

		transform:
			translateY(-50%);

		cursor: pointer;
	}


	/* =============================================================
	   RESET
	============================================================= */

	.reset-button {
		height: 46px;

		padding:
			0 18px;

		background:
			#171717;

		color:
			#fff8e8;

		border:
			2px solid #171717;

		border-radius:
			7px 9px 6px 8px;

		font-size: 9px;

		font-weight: 900;

		letter-spacing:
			0.13em;

		cursor: pointer;
	}


	/* =============================================================
	   RESULT
	============================================================= */

	.result-bar {
		display: flex;

		align-items: center;

		justify-content:
			space-between;

		gap: 20px;

		padding:
			30px 0 18px;

		border-bottom:
			1.5px solid
			rgba(
				23,
				23,
				23,
				0.22
			);
	}


	.result-count {
		display: flex;

		align-items: baseline;

		gap: 8px;
	}


	.result-count-label {
		font-size: 8px;

		font-weight: 900;

		letter-spacing:
			0.15em;

		opacity: 0.45;
	}


	.result-count strong {
		font-size: 22px;

		font-weight: 950;

		letter-spacing:
			-0.04em;
	}


	.result-status {
		font-size: 8px;

		font-weight: 900;

		letter-spacing:
			0.13em;

		opacity: 0.48;
	}


	/* =============================================================
	   GRID
	============================================================= */

	.works-grid {
		display: grid;

		grid-template-columns:
			repeat(
				4,
				minmax(
					0,
					1fr
				)
			);

		column-gap: 28px;

		row-gap: 54px;

		padding-top: 38px;
	}


	.work-card {
		position: relative;

		min-width: 0;
	}


	.work-link {
		display: block;

		width: 100%;

		padding: 0;

		background: transparent;

		border: 0;

		text-align: left;

		cursor: zoom-in;
	}


	.paper-frame {
		position: relative;

		padding: 10px;

		background:
			#fff8e8;

		border:
			2px solid #171717;

		border-radius:
			9px 13px 10px 12px;

		box-shadow:
			5px 6px 0
			rgba(
				23,
				23,
				23,
				0.1
			);

		transform-origin:
			center;

		transition:
			transform 0.28s ease,
			box-shadow 0.28s ease;
	}


	.work-card:nth-child(4n + 1)
		.paper-frame {

		transform:
			rotate(-0.55deg);

	}


	.work-card:nth-child(4n + 2)
		.paper-frame {

		transform:
			rotate(0.7deg);

	}


	.work-card:nth-child(4n + 3)
		.paper-frame {

		transform:
			rotate(-0.35deg);

	}


	.work-card:nth-child(4n)
		.paper-frame {

		transform:
			rotate(0.8deg);

	}


	.work-card:hover
		.paper-frame {

		transform:
			translateY(-7px)
			scale(1.014)
			rotate(0);

		box-shadow:
			8px 12px 0
			rgba(
				23,
				23,
				23,
				0.12
			);

	}


	/* =============================================================
	   IMAGE
	============================================================= */

	.photo-image {
		position: relative;

		width: 100%;

		aspect-ratio:
			2388 / 1668;

		overflow: hidden;

		border:
			1.5px solid
			rgba(
				23,
				23,
				23,
				0.17
			);

		background:
			#54657b;
	}


	.photo-image img {
		display: block;

		width: 100%;

		height: 100%;

		object-fit: cover;
	}


	.photo-index {
		position: absolute;

		top: 9px;

		left: 10px;

		z-index: 3;

		padding:
			3px 5px;

		background:
			rgba(
				23,
				23,
				23,
				0.72
			);

		color:
			#fff8e8;

		font-size: 7px;

		font-weight: 900;

		letter-spacing:
			0.12em;
	}


	/* =============================================================
	   WORK INFO
	============================================================= */

	.work-info {
		display: flex;

		align-items:
			flex-start;

		justify-content:
			space-between;

		gap: 10px;

		padding-top: 10px;
	}


	.work-info h2 {
		margin:
			0 0 4px;

		font-size: 12px;

		font-weight: 950;

		line-height: 1.15;

		letter-spacing:
			-0.02em;
	}


	.work-info p {
		margin: 0;

		font-size: 7px;

		font-weight: 800;

		letter-spacing:
			0.08em;

		opacity: 0.42;
	}


	.work-info time {
		flex: 0 0 auto;

		padding-top: 2px;

		font-size: 8px;

		font-weight: 800;

		letter-spacing:
			0.03em;

		opacity: 0.4;
	}


	/* =============================================================
	   EMPTY
	============================================================= */

	.empty-state {
		padding:
			130px 20px;

		text-align:
			center;
	}


	.empty-doodle {
		margin-bottom: 15px;

		font-size: 52px;

		transform:
			rotate(-12deg);
	}


	.empty-state h2 {
		margin:
			0 0 10px;

		font-size: 32px;

		font-weight: 950;
	}


	.empty-state p {
		margin:
			0 0 24px;

		font-size: 12px;

		font-weight: 600;

		opacity: 0.5;
	}


	.empty-state button {
		padding:
			11px 17px;

		border:
			2px solid #171717;

		border-radius: 8px;

		background:
			#171717;

		color:
			#fff8e8;

		font-size: 9px;

		font-weight: 900;

		cursor: pointer;
	}


	/* =============================================================
	   PAGINATION
	============================================================= */

	.pagination {
		display: flex;

		align-items:
			center;

		justify-content:
			center;

		gap: 18px;

		margin-top: 85px;
	}


	.page-arrow {
		display: grid;

		place-items:
			center;

		width: 42px;

		height: 42px;

		background:
			#fff8e8;

		color:
			#171717;

		border:
			2px solid #171717;

		border-radius: 50%;

		font-size: 17px;

		cursor: pointer;

		box-shadow:
			3px 4px 0
			rgba(
				23,
				23,
				23,
				0.1
			);
	}


	.page-arrow:disabled {
		cursor:
			default;

		opacity:
			0.25;

		box-shadow:
			none;
	}


	.page-numbers {
		display: flex;

		align-items:
			center;

		gap: 6px;
	}


	.page-number {
		display: grid;

		place-items:
			center;

		width: 30px;

		height: 30px;

		padding: 0;

		border: 0;

		border-radius: 50%;

		background:
			transparent;

		color:
			#171717;

		font-size: 9px;

		font-weight: 900;

		cursor: pointer;
	}


	.page-number.active {
		background:
			#171717;

		color:
			#fff8e8;
	}


	.page-ellipsis {
		width: 23px;

		text-align:
			center;

		font-size: 10px;

		opacity: 0.4;
	}


	/* =============================================================
	   LIGHTBOX
	============================================================= */

	body.lightbox-open {
		overflow: hidden;
	}


	.lightbox {
		position: fixed;

		inset: 0;

		z-index: 100;

		display: grid;

		place-items:
			center;

		visibility:
			hidden;

		opacity: 0;

		pointer-events:
			none;

		transition:
			opacity 0.22s ease,
			visibility 0.22s ease;
	}


	.lightbox.is-open {
		visibility:
			visible;

		opacity:
			1;

		pointer-events:
			auto;
	}


	.lightbox-backdrop {
		position: absolute;

		inset: 0;

		background:
			rgba(
				23,
				23,
				23,
				0.9
			);

		backdrop-filter:
			blur(5px);
	}


	.lightbox-shell {
		position: relative;

		z-index: 2;

		display: grid;

		grid-template-columns:
			64px
			minmax(
				0,
				1fr
			)
			64px;

		align-items:
			center;

		gap: 22px;

		width:
			min(
				96vw,
				1450px
			);

		max-height:
			94vh;
	}


	.lightbox-content {
		min-width: 0;

		max-height:
			94vh;

		display: flex;

		flex-direction:
			column;

		align-items:
			center;

		justify-content:
			center;
	}


	.lightbox-image-wrap {
		position: relative;

		display: flex;

		align-items:
			center;

		justify-content:
			center;

		max-width: 100%;

		max-height:
			calc(
				94vh - 78px
			);

		padding: 10px;

		background:
			#fff8e8;

		border:
			2px solid #171717;

		border-radius:
			11px 16px 12px 15px;

		box-shadow:
			9px 10px 0
			rgba(
				0,
				0,
				0,
				0.16
			);
	}


	.lightbox-image-wrap img {
		display: block;

		width: auto;

		height: auto;

		max-width:
			min(
				84vw,
				1280px
			);

		max-height:
			calc(
				94vh - 104px
			);

		object-fit:
			contain;
	}


	.lightbox-caption {
		display: flex;

		align-items:
			baseline;

		justify-content:
			center;

		gap: 14px;

		padding-top: 12px;

		color:
			#fff8e8;

		font-size: 9px;

		font-weight: 800;

		letter-spacing:
			0.12em;

		text-align:
			center;
	}


	.lightbox-caption strong {
		font-size: 12px;

		font-weight: 900;

		letter-spacing:
			-0.01em;
	}


	.lightbox-caption span {
		opacity:
			0.62;
	}


	/* =============================================================
	   CLOSE BUTTON
	============================================================= */

	.lightbox-close {
		position: absolute;

		right: -3px;

		top: -8px;

		z-index: 5;

		width: 42px;

		height: 42px;

		display: grid;

		place-items:
			center;

		appearance:
			none;

		-webkit-appearance:
			none;

		padding: 0;

		border:
			2px solid #171717;

		border-radius:
			50%;

		background:
			#fff8e8;

		color:
			#171717;

		font-size: 25px;

		font-weight: 400;

		line-height: 1;

		cursor:
			pointer;

		box-shadow:
			4px 5px 0
			rgba(
				0,
				0,
				0,
				0.18
			);

		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease;
	}


	.lightbox-close:hover {
		transform:
			translateY(-2px);

		box-shadow:
			4px 8px 0
			rgba(
				0,
				0,
				0,
				0.18
			);
	}


	/* =============================================================
	   SUPER THICK ARROWS
	   
	   不做圆形按钮。
	   直接使用两根超粗线条组成箭头。
	============================================================= */

	.lightbox-arrow {
		position: relative;

		width: 64px;

		height: 92px;

		padding: 0;

		display: grid;

		place-items:
			center;

		appearance:
			none;

		-webkit-appearance:
			none;

		border: 0;

		background:
			transparent;

		color:
			#fff8e8;

		cursor:
			pointer;

		transition:
			transform 0.18s ease,
			opacity 0.18s ease;
	}


	.arrow-line {
		display: block;

		width: 34px;

		height: 34px;

		border-style:
			solid;

		border-color:
			#fff8e8;

		filter:
			drop-shadow(
				2px 3px 0
				rgba(
					0,
					0,
					0,
					0.22
				)
			);
	}


	.arrow-line-prev {
		border-width:
			0 0 9px 9px;

		transform:
			rotate(45deg);
	}


	.arrow-line-next {
		border-width:
			0 9px 9px 0;

		transform:
			rotate(-45deg);
	}


	.lightbox-arrow:hover {
		transform:
			scale(1.13);
	}


	.lightbox-arrow:active {
		transform:
			scale(0.94);
	}


	.lightbox-arrow:disabled {
		opacity:
			0.28;

		pointer-events:
			none;
	}


	/* =============================================================
	   FOCUS
	============================================================= */

	.lightbox-close:focus-visible,
	.lightbox-arrow:focus-visible,
	.work-link:focus-visible {

		outline:
			3px solid
			#fff8e8;

		outline-offset:
			5px;
	}


	/* =============================================================
	   FOOTER
	============================================================= */

	.footer {
		display: flex;

		align-items:
			flex-end;

		justify-content:
			space-between;

		gap: 30px;

		margin-top:
			120px;

		padding:
			25px 0 20px;

		border-top:
			1.5px solid
			rgba(
				23,
				23,
				23,
				0.22
			);
	}


	.footer-brand {
		display: flex;

		flex-direction:
			column;

		gap: 5px;
	}


	.footer-brand span {
		font-size: 15px;

		font-weight: 950;
	}


	.footer-brand small,
	.footer-note span {

		font-size: 8px;

		font-weight: 800;

		letter-spacing:
			0.14em;

		opacity: 0.44;
	}


	.footer-note {
		display: flex;

		gap: 25px;
	}


	/* =============================================================
	   TABLET
	============================================================= */

	@media (max-width: 1100px) {

		.page {

			padding-left:
				28px;

			padding-right:
				28px;

		}


		.filter-section {

			grid-template-columns:
				repeat(
					3,
					minmax(
						0,
						1fr
					)
				)
				auto;

		}


		.works-grid {

			column-gap:
				20px;

			row-gap:
				46px;

		}


		.lightbox-shell {

			grid-template-columns:
				58px
				minmax(
					0,
					1fr
				)
				58px;

			gap:
				14px;

		}

	}


	/* =============================================================
	   MOBILE
	============================================================= */

	@media (max-width: 760px) {

		.page {

			padding-left:
				18px;

			padding-right:
				18px;

		}


		.site-header {

			padding-top:
				22px;

			padding-bottom:
				40px;

		}


		/* FILTER */

		.filter-section {

			grid-template-columns:
				1fr;

			gap:
				12px;

			padding:
				15px;

		}


		.reset-button {

			width:
				100%;

		}


		/* DATE */

		.date-segments {

			padding-left:
				10px;

			padding-right:
				42px;

		}


		#date-year {

			width:
				45px;

		}


		#date-month,
		#date-day {

			width:
				29px;

		}


		/* RESULT */

		.result-bar {

			padding-top:
				25px;

		}


		/* GRID */

		.works-grid {

			grid-template-columns:
				repeat(
					2,
					minmax(
						0,
						1fr
					)
				);

			column-gap:
				15px;

			row-gap:
				34px;

			padding-top:
				27px;

		}


		.paper-frame {

			padding:
				7px;

		}


		.work-info h2 {

			font-size:
				10px;

		}


		.work-info p {

			font-size:
				6px;

			line-height:
				1.4;

		}


		.work-info time {

			font-size:
				7px;

		}


		/* PAGINATION */

		.pagination {

			margin-top:
				58px;

			gap:
				12px;

		}


		.page-arrow {

			width:
				38px;

			height:
				38px;

		}


		.page-numbers {

			gap:
				2px;

		}


		.page-number {

			width:
				27px;

			height:
				27px;

			font-size:
				8px;

		}


		/* =========================================================
		   LIGHTBOX MOBILE
		========================================================= */

		.lightbox-shell {

			grid-template-columns:
				38px
				minmax(
					0,
					1fr
				)
				38px;

			gap:
				4px;

			width:
				98vw;

		}


		.lightbox-image-wrap {

			padding:
				7px;

			border-width:
				1.5px;

			box-shadow:
				6px 7px 0
				rgba(
					0,
					0,
					0,
					0.16
				);

		}


		.lightbox-image-wrap img {

			max-width:
				80vw;

			max-height:
				78vh;

		}


		.lightbox-arrow {

			width:
				38px;

			height:
				60px;

		}


		.arrow-line {

			width:
				25px;

			height:
				25px;

		}


		.arrow-line-prev {

			border-width:
				0 0 7px 7px;

		}


		.arrow-line-next {

			border-width:
				0 7px 7px 0;

		}


		.lightbox-close {

			right:
				-3px;

			top:
				-12px;

			width:
				36px;

			height:
				36px;

			font-size:
				21px;

		}


		.lightbox-caption {

			flex-wrap:
				wrap;

