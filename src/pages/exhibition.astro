---
import Layout from '../layouts/Layout.astro';
import { photoWorks } from '../data/photo';

const defaultDate = photoWorks[0]?.date ?? '';

const [
	defaultYear = '',
	defaultMonth = '',
	defaultDay = '',
] = defaultDate.split('-');
---

<Layout
	title="Exhibition — Roco Photo Gallery"
	description="Browse the complete collection of game photography."
>
	<div class="page">

		<!-- =========================================================
		     HEADER
		========================================================= -->

		<header class="site-header">

			<a
				href="/"
				class="brand"
				aria-label="Roco Photo Gallery"
			>
				<span class="brand-name">
					ROCO
				</span>

				<span class="brand-caption">
					GAME PHOTOGRAPHY
				</span>
			</a>


			<a
				class="back-link"
				href="/"
			>
				<span class="back-arrow">
					←
				</span>

				<span>
					HOME
				</span>
			</a>

		</header>


		<!-- =========================================================
		     FILTERS
		========================================================= -->

		<section
			class="filter-section"
			aria-label="Filter works"
		>

			<!-- DATE -->

			<div class="filter-item date-filter">

				<label for="date-day">
					DATE
				</label>


				<div
					class="filter-control date-control"
					data-default-date={defaultDate}
				>

					<div class="date-segments">

						<input
							id="date-year"
							type="number"
							inputmode="numeric"
							min="1000"
							max="9999"
							value={defaultYear}
							aria-label="Year"
							tabindex="3"
						/>

						<span
							class="date-separator"
							aria-hidden="true"
						>
							-
						</span>

						<input
							id="date-month"
							type="number"
							inputmode="numeric"
							min="1"
							max="12"
							value={defaultMonth}
							aria-label="Month"
							tabindex="2"
						/>

						<span
							class="date-separator"
							aria-hidden="true"
						>
							-
						</span>

						<input
							id="date-day"
							type="number"
							inputmode="numeric"
							min="1"
							max="31"
							value={defaultDay}
							aria-label="Day"
							tabindex="1"
						/>

					</div>


					<button
						class="clear-filter"
						type="button"
						id="clear-date"
						aria-label="Clear date"
					>
						×
					</button>

				</div>

			</div>


			<!-- ROCO -->

			<div class="filter-item">

				<label for="people-filter">
					ROCO
				</label>


				<div class="filter-control">

					<select
						id="people-filter"
						aria-label="Filter by number of people"
					>

						<option value="all">
							ALL
						</option>

						<option value="1">
							1 PERSON
						</option>

						<option value="2">
							2 PEOPLE
						</option>

						<option value="2+">
							2+ PEOPLE
						</option>

					</select>

				</div>

			</div>


			<!-- JINIES -->

			<div class="filter-item">

				<label for="JINIES-filter">
					JINIES
				</label>


				<div class="filter-control">

					<select
						id="JINIES-filter"
						aria-label="Filter by Jinies"
					>

						<option value="all">
							ALL
						</option>

						<option value="yes">
							WITH JINIES
						</option>

						<option value="no">
							WITHOUT JINIES
						</option>

					</select>

				</div>

			</div>


			<!-- RESET -->

			<button
				class="reset-button"
				type="button"
				id="reset-filters"
			>
				RESET
			</button>

		</section>


		<!-- =========================================================
		     RESULT BAR
		========================================================= -->

		<section
			class="result-bar"
			aria-live="polite"
		>

			<div class="result-count">

				<span class="result-count-label">
					WORKS
				</span>

				<strong id="result-count">
					{photoWorks.length}
				</strong>

			</div>


			<div
				class="result-status"
				id="result-status"
			>
				ALL WORKS
			</div>

		</section>


		<!-- =========================================================
		     WORK GRID
		========================================================= -->

		<main
			class="works-grid"
			id="works-grid"
		>

			{photoWorks.map((work, index) => (

				<article
					class={`work-card color-${index % 6}`}
					data-id={work.id}
					data-date={work.date}
					data-order={index + 1}
				>

					<button
						type="button"
						class="work-link lightbox-trigger"
						data-lightbox-index={index}
						data-lightbox-src={work.imageLarge}
						data-lightbox-alt={work.id}
						data-lightbox-title={work.id}
						data-lightbox-date={work.date}
						aria-label={`View ${work.id}`}
					>

						<div class="paper-frame">

							<div class="photo-image">

								<picture>

									<source
										media="(max-width: 760px)"
										srcset={work.imageSmall}
									/>

									<source
										media="(max-width: 1200px)"
										srcset={work.imageMedium}
									/>

									<img
										src={work.imageLarge}
										alt={work.id}
										loading={index < 6 ? 'eager' : 'lazy'}
										decoding="async"
										fetchpriority={index < 6 ? 'high' : 'auto'}
									/>

								</picture>

								<span class="photo-index">
									{String(index + 1).padStart(2, '0')}
								</span>

							</div>

						</div>

					</button>


					<div class="work-info">

						<div>

							<h2>
								{work.id}
							</h2>

							<p data-meta>
								ROCO — &nbsp; / &nbsp; JINIES —
							</p>

						</div>


						<time datetime={work.date}>
							{work.date}
						</time>

					</div>

				</article>

			))}

		</main>


		<!-- =========================================================
		     EMPTY STATE
		========================================================= -->

		<section
			class="empty-state"
			id="empty-state"
			hidden
		>

			<div class="empty-doodle">
				○
			</div>

			<h2>
				No works found.
			</h2>

			<p>
				Try another date or change one of the filters.
			</p>

			<button
				type="button"
				id="empty-reset"
			>
				RESET FILTERS
			</button>

		</section>


		<!-- =========================================================
		     PAGINATION
		========================================================= -->

		<nav
			class="pagination"
			id="pagination"
			aria-label="Pagination"
		>

			<button
				class="page-arrow"
				type="button"
				id="previous-page"
				aria-label="Previous page"
			>
				←
			</button>


			<div
				class="page-numbers"
				id="page-numbers"
			></div>


			<button
				class="page-arrow"
				type="button"
				id="next-page"
				aria-label="Next page"
			>
				→
			</button>

		</nav>


		<!-- =========================================================
		     LIGHTBOX
		========================================================= -->

		<div
			class="lightbox"
			id="lightbox"
			aria-hidden="true"
			role="dialog"
			aria-modal="true"
			aria-label="Image viewer"
		>

			<div
				class="lightbox-backdrop"
				data-lightbox-close
			></div>


			<div class="lightbox-shell">

				<!-- CLOSE -->

				<button
					type="button"
					class="lightbox-close"
					id="lightbox-close"
					aria-label="Close image viewer"
				>
					×
				</button>


				<!-- PREVIOUS -->

				<button
					type="button"
					class="lightbox-arrow lightbox-prev"
					id="lightbox-prev"
					aria-label="Previous photo"
				>
					<span
						class="arrow-line arrow-line-prev"
						aria-hidden="true"
					></span>
				</button>


				<!-- IMAGE -->

				<div class="lightbox-content">

					<div class="lightbox-image-wrap">

						<img
							id="lightbox-image"
							src=""
							alt=""
							loading="eager"
							decoding="async"
						/>

					</div>


					<div class="lightbox-caption">

						<strong id="lightbox-title"></strong>

						<span id="lightbox-date"></span>

						<span id="lightbox-counter"></span>

					</div>

				</div>


				<!-- NEXT -->

				<button
					type="button"
					class="lightbox-arrow lightbox-next"
					id="lightbox-next"
					aria-label="Next photo"
				>
					<span
						class="arrow-line arrow-line-next"
						aria-hidden="true"
					></span>
				</button>

			</div>

		</div>


		<!-- =========================================================
		     FOOTER
		========================================================= -->

		<footer class="footer">

			<div class="footer-brand">

				<span>
					ROCO
				</span>

				<small>
					GAME PHOTOGRAPHY
				</small>

			</div>


			<div class="footer-note">

				<span>
					PERSONAL ARCHIVE
				</span>

				<span>
					{photoWorks.length} WORKS
				</span>

			</div>

		</footer>

	</div>
</Layout>


<script>
  const STORAGE_KEY = 'roco-photo-admin-draft-v1';
  const PAGE_SIZE = 20;

  const CLOUDFLARE_API =
    'https://rocophotogallery.weykeiii.workers.dev';

  type PhotoData = {
    id: string;
    image?: string;
    date?: string;
    people?: number | null;
    JINIES?: boolean | null;
    updatedAt?: string;
  };

  type PhotoStore = Record<string, PhotoData>;

  type LightboxItem = {
    card: HTMLElement;
    trigger: HTMLButtonElement;
    src: string;
    alt: string;
    title: string;
    date: string;
  };

  const cards: HTMLElement[] = Array.from(
    document.querySelectorAll<HTMLElement>('.work-card')
  );

  function getCardsInDomOrder(): HTMLElement[] {
    return Array.from(
      document.querySelectorAll<HTMLElement>('.work-card')
    );
  }

  const dateControl = document.querySelector<HTMLElement>('.date-control');

  const dateYear =
    document.querySelector<HTMLInputElement>('#date-year');

  const dateMonth =
    document.querySelector<HTMLInputElement>('#date-month');

  const dateDay =
    document.querySelector<HTMLInputElement>('#date-day');

  const clearDateButton =
    document.querySelector<HTMLButtonElement>('#clear-date');

  const peopleSelect =
    document.querySelector<HTMLSelectElement>('#people-filter');

  const JINIESSelect =
    document.querySelector<HTMLSelectElement>('#JINIES-filter');

  const resetButton =
    document.querySelector<HTMLButtonElement>('#reset-filters');

  const resultCount =
    document.querySelector<HTMLElement>('#result-count');

  const resultStatus =
    document.querySelector<HTMLElement>('#result-status');

  const emptyState =
    document.querySelector<HTMLElement>('#empty-state');

  const pagination =
    document.querySelector<HTMLElement>('#pagination');

  const lightbox =
    document.querySelector<HTMLElement>('#lightbox');

  const lightboxImage =
    document.querySelector<HTMLImageElement>('#lightbox-image');

  const lightboxTitle =
    document.querySelector<HTMLElement>('#lightbox-title');

  const lightboxDate =
    document.querySelector<HTMLElement>('#lightbox-date');

  const lightboxCounter =
    document.querySelector<HTMLElement>('#lightbox-counter');

  const lightboxPrevious =
    document.querySelector<HTMLButtonElement>('#lightbox-prev');

  const lightboxNext =
    document.querySelector<HTMLButtonElement>('#lightbox-next');

  const lightboxClose =
    document.querySelector<HTMLButtonElement>('#lightbox-close');

  let currentPage = 1;
  let filtersActivated = false;

  const DEFAULT_DATE =
    dateControl?.dataset.defaultDate ?? '';

  let lightboxItems: LightboxItem[] = [];
  let currentLightboxIndex = 0;

  function isValidDate(value: string): boolean {
    return /^\d{4}-\d{2}-\d{2}$/.test(value);
  }

  function readStore(): PhotoStore {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);

      if (!raw) {
        return {};
      }

      const parsed: unknown = JSON.parse(raw);

      /*
       * 兼容两种格式：
       *
       * 旧格式：
       * [
       *   { id: "...", date: "...", people: 1, JINIES: false }
       * ]
       *
       * 新格式：
       * {
       *   "20260915-016": {
       *      id: "...",
       *      date: "...",
       *      people: 1,
       *      JINIES: false
       *   }
       * }
       */

      if (Array.isArray(parsed)) {
        return parsed.reduce<PhotoStore>(
          (store: PhotoStore, item: unknown) => {
            if (
              item &&
              typeof item === 'object' &&
              'id' in item
            ) {
              const row = item as PhotoData;

              if (typeof row.id === 'string') {
                store[row.id] = row;
              }
            }

            return store;
          },
          {}
        );
      }

      if (
        parsed &&
        typeof parsed === 'object' &&
        !Array.isArray(parsed)
      ) {
        return parsed as PhotoStore;
      }

      return {};
    } catch (error) {
      console.warn(
        '[Exhibition] Failed to read localStorage:',
        error
      );

      return {};
    }
  }

  function getSavedData(
    id: string,
    store: PhotoStore
  ): PhotoData | undefined {
    return store[id];
  }

  async function fetchCloudStore(): Promise<PhotoStore> {
    const response = await fetch(
      `${CLOUDFLARE_API}/api/photos?t=${Date.now()}`,
      {
        method: 'GET',
        headers: {
          Accept: 'application/json',
        },
        cache: 'no-store',
      }
    );

    if (!response.ok) {
      throw new Error(
        `GET /api/photos failed: ${response.status}`
      );
    }

    const result: unknown = await response.json();

    if (
      !result ||
      typeof result !== 'object' ||
      !('photos' in result) ||
      !result.photos ||
      typeof result.photos !== 'object'
    ) {
      throw new Error(
        'Cloud photo metadata returned an invalid response.'
      );
    }

    const cloudPhotos =
      result.photos as Record<string, unknown>;

    return Object.entries(cloudPhotos).reduce<PhotoStore>(
      (store: PhotoStore, [id, value]: [string, unknown]) => {
        if (!value || typeof value !== 'object') {
          return store;
        }

        const row = value as Record<string, unknown>;

        store[id] = {
          id,
          image:
            typeof row.image === 'string'
              ? row.image
              : undefined,
          date:
            typeof row.date === 'string'
              ? row.date
              : undefined,
          people:
            typeof row.people === 'number'
              ? row.people
              : null,
          JINIES:
            row.jinies === 1 ||
            row.jinies === true
              ? true
              : row.jinies === 0 ||
                row.jinies === false
              ? false
              : null,
          updatedAt:
            typeof row.updatedAt === 'string'
              ? row.updatedAt
              : undefined,
        };

        return store;
      },
      {}
    );
  }

  function getUpdatedTimestamp(
    photo: PhotoData | undefined
  ): number {
    if (!photo?.updatedAt) {
      return 0;
    }

    const timestamp = Date.parse(photo.updatedAt);

    return Number.isNaN(timestamp)
      ? 0
      : timestamp;
  }

  function mergeStores(
    localStore: PhotoStore,
    cloudStore: PhotoStore
  ): PhotoStore {
    const merged: PhotoStore = {
      ...localStore,
    };

    /*
     * Exhibition 是只读展示页。
     * 跨设备同步时，Cloudflare D1 是最终数据源。
     * 因此只要云端存在某张照片的记录，就直接以云端记录覆盖本地旧缓存。
     */
    Object.entries(cloudStore).forEach(
      ([id, cloudPhoto]) => {
        const localPhoto = merged[id];

        merged[id] = {
          ...localPhoto,
          ...cloudPhoto,
        };
      }
    );

    return merged;
  }

  async function refreshFromCloud(): Promise<void> {
    try {
      const localStore = readStore();
      const cloudStore = await fetchCloudStore();
      const mergedStore = mergeStores(
        localStore,
        cloudStore
      );

      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify(mergedStore)
      );

      applyMetadata(mergedStore);
      updateFilterState();
      currentPage = 1;
      render();
    } catch (error) {
      console.warn(
        '[Exhibition] Failed to sync cloud photo metadata:',
        error
      );
    }
  }

  function getPeopleLabel(
    people: number | null | undefined
  ): string {
    if (people === 0) {
      return '0 PEOPLE';
    }

    if (people === 1) {
      return '1 PERSON';
    }

    if (people === 2) {
      return '2 PEOPLE';
    }

    if (people === 3) {
      return '2+ PEOPLE';
    }

    return 'ROCO —';
  }

  function getJINIESLabel(
    JINIES: boolean | null | undefined
  ): string {
    if (JINIES === true) {
      return 'JINIES';
    }

    if (JINIES === false) {
      return 'NO JINIES';
    }

    return 'JINIES —';
  }

  function getDateValue(
    card: HTMLElement,
    saved: PhotoData | undefined
  ): string {
    if (saved?.date && isValidDate(saved.date)) {
      return saved.date;
    }

    return card.dataset.date ?? '';
  }

  function applyMetadata(store: PhotoStore = readStore()): void {

    cards.forEach((card: HTMLElement) => {
      const id = card.dataset.id ?? '';

      if (!id) {
        return;
      }

      const saved = getSavedData(id, store);

      const meta =
        card.querySelector<HTMLElement>('[data-meta]');

      const time =
        card.querySelector<HTMLTimeElement>('time');

      const trigger =
        card.querySelector<HTMLButtonElement>(
          '.lightbox-trigger'
        );

      if (!meta) {
        return;
      }

      const people = saved?.people ?? null;
      const JINIES = saved?.JINIES ?? null;

      /*
       * 更新人物 / JINIES 文案
       */
      meta.textContent =
        `${getPeopleLabel(people)} / ${getJINIESLabel(JINIES)}`;

      /*
       * 更新 data 属性
       */
      if (people === 0) {
        card.dataset.people = '0';
      } else if (people === 1) {
        card.dataset.people = '1';
      } else if (people === 2) {
        card.dataset.people = '2';
      } else if (people === 3) {
        card.dataset.people = '2+';
      } else {
        delete card.dataset.people;
      }

      if (JINIES === true) {
        card.dataset.JINIES = 'yes';
      } else if (JINIES === false) {
        card.dataset.JINIES = 'no';
      } else {
        delete card.dataset.JINIES;
      }

      /*
       * 更新日期
       */
      const finalDate = getDateValue(card, saved);

      if (finalDate) {
        card.dataset.date = finalDate;

        if (time) {
          time.dateTime = finalDate;
          time.textContent = finalDate;
        }

        if (trigger) {
          trigger.dataset.lightboxDate = finalDate;
        }
      }
    });

    /*
     * 按最终日期重新排序：
     * 最新 → 最旧
     */
    const grid =
      document.querySelector<HTMLElement>('#works-grid');


const originalOrder = new Map(
  cards.map((card, index) => [card, index])
);

    const sortedCards = getCardsInDomOrder().sort(
      (a: HTMLElement, b: HTMLElement) => {
        const dateA = a.dataset.date ?? '';
        const dateB = b.dataset.date ?? '';

        const validA = isValidDate(dateA);
        const validB = isValidDate(dateB);

        if (validA && validB) {
          if (dateA !== dateB) {
            return dateB.localeCompare(dateA);
          }
        }

        if (validA && !validB) {
          return -1;
        }

        if (!validA && validB) {
          return 1;
        }

        return (
          (originalOrder.get(a) ?? 0) -
          (originalOrder.get(b) ?? 0)
        );
      }
    );

    if (!grid) {
      return;
    }

    sortedCards.forEach((card: HTMLElement) => {
      grid.appendChild(card);
    });
  }

  function getCurrentDateFilter(): string {
    if (!dateYear || !dateMonth || !dateDay) {
      return '';
    }

    const year = dateYear.value.trim();
    const month = dateMonth.value.trim();
    const day = dateDay.value.trim();

    if (!year && !month && !day) {
      return '';
    }

    if (
      year.length === 4 &&
      month.length === 2 &&
      day.length === 2
    ) {
      const value = `${year}-${month}-${day}`;

      if (isValidDate(value)) {
        return value;
      }
    }

    return `${year}-${month}-${day}`;
  }

  function clearDateInputs(): void {
    if (dateYear) {
      dateYear.value = '';
    }

    if (dateMonth) {
      dateMonth.value = '';
    }

    if (dateDay) {
      dateDay.value = '';
    }
  }

  function setDateInputs(value: string): void {
    if (!dateYear || !dateMonth || !dateDay) {
      return;
    }

    if (!value || !isValidDate(value)) {
      clearDateInputs();
      return;
    }

    const parts = value.split('-');

    dateYear.value = parts[0] ?? '';
    dateMonth.value = parts[1] ?? '';
    dateDay.value = parts[2] ?? '';
  }

  function matchesDateFilter(
    card: HTMLElement,
    filter: string
  ): boolean {
    if (!filter) {
      return true;
    }

    const cardDate = card.dataset.date ?? '';

    /*
     * 完整日期：精确匹配
     */
    if (filter.length === 10) {
      return cardDate === filter;
    }

    /*
     * 部分日期：
     * 输入 2026 → 匹配年份
     * 输入 2026-09 → 匹配年月
     */
    return cardDate.startsWith(filter);
  }

  function matchesPeopleFilter(
    card: HTMLElement
  ): boolean {
    const value = peopleSelect?.value ?? 'all';

    if (value === 'all') {
      return true;
    }

    const people = card.dataset.people ?? '';

    if (value === '1') {
      return people === '1';
    }

    if (value === '2') {
      return people === '2';
    }

    if (value === '2+') {
      return people === '2+';
    }

    return true;
  }

  function matchesJINIESFilter(
    card: HTMLElement
  ): boolean {
    const value = JINIESSelect?.value ?? 'all';

    if (value === 'all') {
      return true;
    }

    const JINIES = card.dataset.JINIES ?? '';

    if (value === 'yes') {
      return JINIES === 'yes';
    }

    if (value === 'no') {
      return JINIES === 'no';
    }

    return true;
  }

  function getFilteredCards(): HTMLElement[] {
    const dateFilter = getCurrentDateFilter();

    return getCardsInDomOrder().filter(
      (card: HTMLElement) => {
        return (
          matchesDateFilter(card, dateFilter) &&
          matchesPeopleFilter(card) &&
          matchesJINIESFilter(card)
        );
      }
    );
  }

  function updateFilterState(): void {
    const dateFilter = getCurrentDateFilter();

    const peopleFilter =
      peopleSelect?.value ?? 'all';

    const JINIESFilter =
      JINIESSelect?.value ?? 'all';

    filtersActivated =
      Boolean(
        dateFilter ||
        peopleFilter !== 'all' ||
        JINIESFilter !== 'all'
      );
  }

  function updateResultStatus(
    total: number
  ): void {
    if (!resultStatus) {
      return;
    }

    if (!filtersActivated) {
      resultStatus.textContent = 'ALL WORKS';
      return;
    }

    resultStatus.textContent =
      `${total} ${total === 1 ? 'WORK' : 'WORKS'}`;
  }

  function renderPagination(
    total: number
  ): void {
    if (!pagination) {
      return;
    }

    pagination.innerHTML = '';

    const totalPages =
      Math.ceil(total / PAGE_SIZE);

    if (totalPages <= 1) {
      pagination.hidden = true;
      return;
    }

    pagination.hidden = false;

    const createPageButton = (
      label: string,
      page: number,
      disabled = false
    ): HTMLButtonElement => {
      const button =
        document.createElement('button');

      button.type = 'button';
      button.className = 'page-button';
      button.textContent = label;
      button.disabled = disabled;

      if (page === currentPage) {
        button.classList.add('is-active');
        button.setAttribute(
          'aria-current',
          'page'
        );
      }

      button.addEventListener(
        'click',
        () => {
          currentPage = page;
          render();
          window.scrollTo({
            top: 0,
            behavior: 'smooth',
          });
        }
      );

      return button;
    };

    pagination.appendChild(
      createPageButton(
        '←',
        currentPage - 1,
        currentPage <= 1
      )
    );

    for (
      let page = 1;
      page <= totalPages;
      page += 1
    ) {
      pagination.appendChild(
        createPageButton(
          String(page),
          page
        )
      );
    }

    pagination.appendChild(
      createPageButton(
        '→',
        currentPage + 1,
        currentPage >= totalPages
      )
    );
  }

  function render(): void {
    const filteredCards =
      getFilteredCards();

    const total =
      filteredCards.length;

    const totalPages =
      Math.max(
        1,
        Math.ceil(total / PAGE_SIZE)
      );

    if (currentPage > totalPages) {
      currentPage = totalPages;
    }

    const start =
      (currentPage - 1) * PAGE_SIZE;

    const end =
      start + PAGE_SIZE;

    const visibleCards =
      new Set(
        filteredCards.slice(start, end)
      );

    getCardsInDomOrder().forEach(
      (card: HTMLElement) => {
        card.style.display =
          visibleCards.has(card)
            ? ''
            : 'none';
      }
    );

    if (resultCount) {
      resultCount.textContent =
        String(total);
    }

    updateResultStatus(total);

    if (emptyState) {
      emptyState.hidden = total !== 0;
    }

    renderPagination(total);

    /*
     * 更新当前 Lightbox 数据
     */
    lightboxItems =
      filteredCards.map(
        (card: HTMLElement) => {
          const trigger =
            card.querySelector<HTMLButtonElement>(
              '.lightbox-trigger'
            );

          const image =
            card.querySelector<HTMLImageElement>(
              'img'
            );

          return {
            card,
            trigger: trigger as HTMLButtonElement,
            src:
              trigger?.dataset.lightboxSrc ??
              image?.src ??
              '',
            alt:
              trigger?.dataset.lightboxAlt ??
              image?.alt ??
              '',
            title:
              trigger?.dataset.lightboxTitle ??
              card.dataset.id ??
              '',
            date:
              card.dataset.date ??
              '',
          };
        }
      )
      .filter(
        (item: LightboxItem) =>
          Boolean(item.trigger)
      );
  }

  function resetFilters(): void {
    clearDateInputs();

    if (peopleSelect) {
      peopleSelect.value = 'all';
    }

    if (JINIESSelect) {
      JINIESSelect.value = 'all';
    }

    filtersActivated = false;
    currentPage = 1;

    render();
  }

  function openLightbox(
    index: number
  ): void {
    if (
      !lightbox ||
      !lightboxImage ||
      !lightboxTitle ||
      !lightboxDate ||
      !lightboxCounter
    ) {
      return;
    }

    if (
      index < 0 ||
      index >= lightboxItems.length
    ) {
      return;
    }

    currentLightboxIndex = index;

    const item =
      lightboxItems[currentLightboxIndex];

    if (!item) {
      return;
    }

    lightboxImage.src = item.src;
    lightboxImage.alt = item.alt;
    lightboxTitle.textContent = item.title;
    lightboxDate.textContent = item.date;

    lightboxCounter.textContent =
      `${currentLightboxIndex + 1} / ${lightboxItems.length}`;

    lightbox.hidden = false;
    lightbox.classList.add('is-open');
    document.body.classList.add(
      'lightbox-open'
    );

    updateLightboxButtons();
  }

  function closeLightbox(): void {
    if (!lightbox) {
      return;
    }

    lightbox.classList.remove('is-open');
    lightbox.hidden = true;

    document.body.classList.remove(
      'lightbox-open'
    );
  }

  function updateLightboxButtons(): void {
    if (lightboxPrevious) {
      lightboxPrevious.disabled =
        lightboxItems.length <= 1;
    }

    if (lightboxNext) {
      lightboxNext.disabled =
        lightboxItems.length <= 1;
    }
  }

  function moveLightbox(
    direction: number
  ): void {
    if (lightboxItems.length <= 1) {
      return;
    }

    currentLightboxIndex =
      (
        currentLightboxIndex +
        direction +
        lightboxItems.length
      ) %
      lightboxItems.length;

    openLightbox(
      currentLightboxIndex
    );
  }

  function openFromTrigger(
    trigger: HTMLButtonElement
  ): void {
    const card =
      trigger.closest<HTMLElement>(
        '.work-card'
      );

    if (!card) {
      return;
    }

    const visibleCards =
      getFilteredCards();

    const index =
      visibleCards.indexOf(card);

    if (index === -1) {
      return;
    }

    openLightbox(index);
  }

  /*
   * Filter events
   */
  [
    dateYear,
    dateMonth,
    dateDay,
  ].forEach(
    (input: HTMLInputElement | null) => {
      input?.addEventListener(
        'input',
        () => {
          updateFilterState();
          currentPage = 1;
          render();
        }
      );
    }
  );

  peopleSelect?.addEventListener(
    'change',
    () => {
      updateFilterState();
      currentPage = 1;
      render();
    }
  );

  JINIESSelect?.addEventListener(
    'change',
    () => {
      updateFilterState();
      currentPage = 1;
      render();
    }
  );

  clearDateButton?.addEventListener(
    'click',
    () => {
      clearDateInputs();
      updateFilterState();
      currentPage = 1;
      render();
    }
  );

  resetButton?.addEventListener(
    'click',
    resetFilters
  );

  /*
   * Lightbox open
   */
  document.addEventListener(
    'click',
    (event: MouseEvent) => {
      const target =
        event.target as HTMLElement | null;

      const trigger =
        target?.closest<HTMLButtonElement>(
          '.lightbox-trigger'
        );

      if (!trigger) {
        return;
      }

      event.preventDefault();

      openFromTrigger(trigger);
    }
  );

  lightboxClose?.addEventListener(
    'click',
    closeLightbox
  );

  lightboxPrevious?.addEventListener(
    'click',
    () => {
      moveLightbox(-1);
    }
  );

  lightboxNext?.addEventListener(
    'click',
    () => {
      moveLightbox(1);
    }
  );

  /*
   * 点击遮罩关闭
   */
  lightbox?.addEventListener(
    'click',
    (event: MouseEvent) => {
      if (
        event.target === lightbox
      ) {
        closeLightbox();
      }
    }
  );

  /*
   * 键盘控制
   */
  document.addEventListener(
    'keydown',
    (event: KeyboardEvent) => {
      if (
        lightbox &&
        !lightbox.hidden
      ) {
        if (event.key === 'Escape') {
          closeLightbox();
        } else if (
          event.key === 'ArrowLeft'
        ) {
          moveLightbox(-1);
        } else if (
          event.key === 'ArrowRight'
        ) {
          moveLightbox(1);
        }
      }
    }
  );

  function refreshFromStorage(): void {
    applyMetadata();

    updateFilterState();

    currentPage = 1;

    render();
  }

  /*
   * Admin 页面修改 localStorage 后，
   * Exhibition 页面打开时 / 返回时重新读取。
   */
  window.addEventListener(
    'storage',
    (event: StorageEvent) => {
      if (
        event.key === STORAGE_KEY
      ) {
        refreshFromStorage();
      }
    }
  );

  window.addEventListener(
    'pageshow',
    () => {
      refreshFromStorage();
      void refreshFromCloud();
    }
  );

  document.addEventListener(
    'astro:page-load',
    () => {
      refreshFromStorage();
      void refreshFromCloud();
    }
  );

  /*
   * 初始化
   */
  if (
    DEFAULT_DATE &&
    dateYear &&
    dateMonth &&
    dateDay
  ) {
    /*
     * 保留原来的默认日期，
     * 但不主动激活日期筛选。
     */
    setDateInputs('');
  }

  applyMetadata();
  updateFilterState();
  render();

  void refreshFromCloud();
</script>

