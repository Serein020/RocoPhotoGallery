---
import Layout from '../layouts/Layout.astro';
import { photoWorks } from '../data/photo';

const defaultDate = photoWorks[0]?.date ?? '';

const [
	defaultYear = '',
	defaultMonth = '',
	defaultDay = '',
] = defaultDate.split('-');
---

<Layout
	title="Exhibition — Roco Photo Gallery"
	description="Browse the complete collection of game photography."
>
	<div class="page">

		<!-- =========================================================
		     HEADER
		========================================================= -->

		<header class="site-header">

			<a
				href="/"
				class="brand"
				aria-label="Roco Photo Gallery"
			>
				<span class="brand-name">
					ROCO
				</span>

				<span class="brand-caption">
					GAME PHOTOGRAPHY
				</span>
			</a>


			<a
				class="back-link"
				href="/"
			>
				<span class="back-arrow">
					←
				</span>

				<span>
					HOME
				</span>
			</a>

		</header>


		<!-- =========================================================
		     FILTERS
		========================================================= -->

		<section
			class="filter-section"
			aria-label="Filter works"
		>

			<!-- DATE -->

			<div class="filter-item date-filter">

				<label for="date-day">
					DATE
				</label>


				<div
					class="filter-control date-control"
					data-default-date={defaultDate}
				>

					<div class="date-segments">

						<input
							id="date-year"
							type="number"
							inputmode="numeric"
							min="1000"
							max="9999"
							value={defaultYear}
							aria-label="Year"
							tabindex="3"
						/>

						<span
							class="date-separator"
							aria-hidden="true"
						>
							-
						</span>

						<input
							id="date-month"
							type="number"
							inputmode="numeric"
							min="1"
							max="12"
							value={defaultMonth}
							aria-label="Month"
							tabindex="2"
						/>

						<span
							class="date-separator"
							aria-hidden="true"
						>
							-
						</span>

						<input
							id="date-day"
							type="number"
							inputmode="numeric"
							min="1"
							max="31"
							value={defaultDay}
							aria-label="Day"
							tabindex="1"
						/>

					</div>


					<button
						class="clear-filter"
						type="button"
						id="clear-date"
						aria-label="Clear date"
					>
						×
					</button>

				</div>

			</div>


			<!-- ROCO -->

			<div class="filter-item">

				<label for="people-filter">
					ROCO
				</label>


				<div class="filter-control">

					<select
						id="people-filter"
						aria-label="Filter by number of people"
					>

						<option value="all">
							ALL
						</option>

						<option value="1">
							1 PERSON
						</option>

						<option value="2">
							2 PEOPLE
						</option>

						<option value="2+">
							2+ PEOPLE
						</option>

					</select>

				</div>

			</div>


			<!-- JINIES -->

			<div class="filter-item">

				<label for="JINIES-filter">
					JINIES
				</label>


				<div class="filter-control">

					<select
						id="JINIES-filter"
						aria-label="Filter by Jinies"
					>

						<option value="all">
							ALL
						</option>

						<option value="yes">
							WITH JINIES
						</option>

						<option value="no">
							WITHOUT JINIES
						</option>

					</select>

				</div>

			</div>


			<!-- RESET -->

			<button
				class="reset-button"
				type="button"
				id="reset-filters"
			>
				RESET
			</button>

		</section>


		<!-- =========================================================
		     RESULT BAR
		========================================================= -->

		<section
			class="result-bar"
			aria-live="polite"
		>

			<div class="result-count">

				<span class="result-count-label">
					WORKS
				</span>

				<strong id="result-count">
					{photoWorks.length}
				</strong>

			</div>


			<div
				class="result-status"
				id="result-status"
			>
				ALL WORKS
			</div>

		</section>


		<!-- =========================================================
		     WORK GRID
		========================================================= -->

		<main
			class="works-grid"
			id="works-grid"
		>

			{photoWorks.map((work, index) => (

				<article
					class={`work-card color-${index % 6}`}
					data-id={work.id}
					data-date={work.date}
					data-order={index + 1}
				>

					<button
						type="button"
						class="work-link lightbox-trigger"
						data-lightbox-index={index}
						data-lightbox-src={work.image}
						data-lightbox-alt={work.id}
						data-lightbox-title={work.id}
						data-lightbox-date={work.date}
						aria-label={`View ${work.id}`}
					>

						<div class="paper-frame">

							<div class="photo-image">

								<img
									src={work.image}
									alt={work.id}
									loading="lazy"
									decoding="async"
								/>

								<span class="photo-index">
									{String(index + 1).padStart(2, '0')}
								</span>

							</div>

						</div>

					</button>


					<div class="work-info">

						<div>

							<h2>
								{work.id}
							</h2>

							<p data-meta>
								ROCO — &nbsp; / &nbsp; JINIES —
							</p>

						</div>


						<time datetime={work.date}>
							{work.date}
						</time>

					</div>

				</article>

			))}

		</main>


		<!-- =========================================================
		     EMPTY STATE
		========================================================= -->

		<section
			class="empty-state"
			id="empty-state"
			hidden
		>

			<div class="empty-doodle">
				○
			</div>

			<h2>
				No works found.
			</h2>

			<p>
				Try another date or change one of the filters.
			</p>

			<button
				type="button"
				id="empty-reset"
			>
				RESET FILTERS
			</button>

		</section>


		<!-- =========================================================
		     PAGINATION
		========================================================= -->

		<nav
			class="pagination"
			id="pagination"
			aria-label="Pagination"
		>

			<button
				class="page-arrow"
				type="button"
				id="previous-page"
				aria-label="Previous page"
			>
				←
			</button>


			<div
				class="page-numbers"
				id="page-numbers"
			></div>


			<button
				class="page-arrow"
				type="button"
				id="next-page"
				aria-label="Next page"
			>
				→
			</button>

		</nav>


		<!-- =========================================================
		     LIGHTBOX
		========================================================= -->

		<div
			class="lightbox"
			id="lightbox"
			aria-hidden="true"
			role="dialog"
			aria-modal="true"
			aria-label="Image viewer"
		>

			<div
				class="lightbox-backdrop"
				data-lightbox-close
			></div>


			<div class="lightbox-shell">

				<!-- CLOSE -->

				<button
					type="button"
					class="lightbox-close"
					id="lightbox-close"
					aria-label="Close image viewer"
				>
					×
				</button>


				<!-- PREVIOUS -->

				<button
					type="button"
					class="lightbox-arrow lightbox-prev"
					id="lightbox-prev"
					aria-label="Previous photo"
				>
					<span
						class="arrow-line arrow-line-prev"
						aria-hidden="true"
					></span>
				</button>


				<!-- IMAGE -->

				<div class="lightbox-content">

					<div class="lightbox-image-wrap">

						<img
							id="lightbox-image"
							src=""
							alt=""
						/>

					</div>


					<div class="lightbox-caption">

						<strong id="lightbox-title"></strong>

						<span id="lightbox-date"></span>

						<span id="lightbox-counter"></span>

					</div>

				</div>


				<!-- NEXT -->

				<button
					type="button"
					class="lightbox-arrow lightbox-next"
					id="lightbox-next"
					aria-label="Next photo"
				>
					<span
						class="arrow-line arrow-line-next"
						aria-hidden="true"
					></span>
				</button>

			</div>

		</div>


		<!-- =========================================================
		     FOOTER
		========================================================= -->

		<footer class="footer">

			<div class="footer-brand">

				<span>
					ROCO
				</span>

				<small>
					GAME PHOTOGRAPHY
				</small>

			</div>


			<div class="footer-note">

				<span>
					PERSONAL ARCHIVE
				</span>

				<span>
					{photoWorks.length} WORKS
				</span>

			</div>

		</footer>

	</div>
</Layout>


<script>
	/* =============================================================
	   CONSTANTS
	============================================================= */

	const STORAGE_KEY =
		'roco-photo-admin-draft-v1';

	const PAGE_SIZE =
		20;


	/* =============================================================
	   DOM
	============================================================= */

	const cards =
		Array.from(
			document.querySelectorAll<HTMLElement>(
				'.work-card'
			)
		);


	/*
	 * 始终获取当前 DOM 中的实际作品顺序。
	 *
	 * 重要：
	 * Admin 修改 DATE 后，作品会重新排序。
	 * 因此后续筛选、分页、Lightbox 都不能继续依赖
	 * 最初的 cards 数组顺序。
	 */

	function getCardsInDomOrder() {

		return Array.from(
			document.querySelectorAll<HTMLElement>(
				'.work-card'
			)
		);

	}


	const dateControl =
		document.querySelector<HTMLElement>(
			'.date-control'
		);


	const dateYear =
		document.querySelector<HTMLInputElement>(
			'#date-year'
		);


	const dateMonth =
		document.querySelector<HTMLInputElement>(
			'#date-month'
		);


	const dateDay =
		document.querySelector<HTMLInputElement>(
			'#date-day'
		);


	const peopleSelect =
		document.querySelector<HTMLSelectElement>(
			'#people-filter'
		);


	const JINIESSelect =
		document.querySelector<HTMLSelectElement>(
			'#JINIES-filter'
		);


	const clearDateButton =
		document.querySelector<HTMLButtonElement>(
			'#clear-date'
		);


	const resetButton =
		document.querySelector<HTMLButtonElement>(
			'#reset-filters'
		);


	const emptyReset =
		document.querySelector<HTMLButtonElement>(
			'#empty-reset'
		);


	const resultCount =
		document.querySelector<HTMLElement>(
			'#result-count'
		);


	const resultStatus =
		document.querySelector<HTMLElement>(
			'#result-status'
		);


	const emptyState =
		document.querySelector<HTMLElement>(
			'#empty-state'
		);


	const pagination =
		document.querySelector<HTMLElement>(
			'#pagination'
		);


	const pageNumbers =
		document.querySelector<HTMLElement>(
			'#page-numbers'
		);


	const previousPage =
		document.querySelector<HTMLButtonElement>(
			'#previous-page'
		);


	const nextPage =
		document.querySelector<HTMLButtonElement>(
			'#next-page'
		);


	/* =============================================================
	   LIGHTBOX DOM
	============================================================= */

	const lightbox =
		document.querySelector<HTMLElement>(
			'#lightbox'
		);


	const lightboxImage =
		document.querySelector<HTMLImageElement>(
			'#lightbox-image'
		);


	const lightboxTitle =
		document.querySelector<HTMLElement>(
			'#lightbox-title'
		);


	const lightboxDate =
		document.querySelector<HTMLElement>(
			'#lightbox-date'
		);


	const lightboxCounter =
		document.querySelector<HTMLElement>(
			'#lightbox-counter'
		);


	const lightboxClose =
		document.querySelector<HTMLButtonElement>(
			'#lightbox-close'
		);


	const lightboxPrevious =
		document.querySelector<HTMLButtonElement>(
			'#lightbox-prev'
		);


	const lightboxNext =
		document.querySelector<HTMLButtonElement>(
			'#lightbox-next'
		);


	/* =============================================================
	   STATE
	============================================================= */

	let currentPage =
		1;


	/*
	 * 初始状态：
	 *
	 * DATE 显示最新 DATE，
	 * 但不立即执行 DATE 筛选。
	 */

	let filtersActivated =
		false;


	const DEFAULT_DATE =
		dateControl?.dataset.defaultDate ??
		'';


	let lightboxItems: Array<{
		src: string;
		alt: string;
		title: string;
		date: string;
	}> = [];


	let lightboxIndex =
		0;


	let lastFocusedElement:
		HTMLElement | null =
		null;


	let touchStartX =
		0;


	/* =============================================================
	   STORAGE
	============================================================= */

	function readStore(): Record<
		string,
		{
			date?: string;
			people?: number | null;
			JINIES?: boolean | null;
		}
	> {

		try {

			const raw =
				localStorage.getItem(
					STORAGE_KEY
				);


			if (!raw) {

				return {};

			}


			const parsed =
				JSON.parse(raw);


			return parsed &&
				typeof parsed === 'object'
				? parsed
				: {};

		} catch {

			return {};

		}

	}


	/* =============================================================
	   DATE VALIDATION
	============================================================= */

	function isValidDateString(
		value: string
	) {

		return /^\d{4}-\d{2}-\d{2}$/.test(
			value
		);

	}


	/* =============================================================
	   APPLY ADMIN METADATA
	============================================================= */

	function applyMetadata() {

		const store =
			readStore();


		cards.forEach(
			(card) => {

				const id =
					card.dataset.id ??
					'';


				const saved =
					store[id];


				const meta =
					card.querySelector<HTMLElement>(
						'[data-meta]'
					);


				const time =
					card.querySelector<HTMLTimeElement>(
						'time'
					);


				const trigger =
					card.querySelector<HTMLButtonElement>(
						'.lightbox-trigger'
					);


				const people =
					saved?.people ??
					null;


				const JINIES =
					saved?.JINIES ??
					null;


				const peopleText =
					people === 1
						? '1 PERSON'
						: people !== null &&
								people >= 2
							? '2+ PEOPLE'
							: 'ROCO —';


				const JINIESText =
					JINIES === true
						? 'JINIES'
						: JINIES === false
							? 'NO JINIES'
							: 'JINIES —';


				/*
				 * 更新 ROCO / JINIES 信息。
				 */

				if (meta) {

					meta.textContent =
						`${peopleText} / ${JINIESText}`;

				}


				card.dataset.people =
					people !== null &&
						people >= 2
						? '2+'
						: people === 1
							? '1'
							: '';


				card.dataset.JINIES =
					JINIES === true
						? 'yes'
						: JINIES === false
							? 'no'
							: '';


				/*
				 * =================================================
				 * DATE
				 * =================================================
				 *
				 * Admin 修改过：
				 * 使用 Admin DATE。
				 *
				 * 没有修改：
				 * 使用 photo.ts 原始 DATE。
				 */

				if (
					saved?.date &&
					isValidDateString(
						saved.date
					)
				) {

					card.dataset.date =
						saved.date;


					if (time) {

						time.dateTime =
							saved.date;

						time.textContent =
							saved.date;

					}


					/*
					 * 同步 Lightbox DATE。
					 */

					if (trigger) {

						trigger.dataset.lightboxDate =
							saved.date;

					}

				} else {

					/*
					 * 没有 Admin DATE 覆盖时，
					 * 使用卡片当前 DATE。
					 */

					if (trigger) {

						trigger.dataset.lightboxDate =
							card.dataset.date ??
							'';

					}

				}

			}
		);


		/* =========================================================
		   REORDER WORKS
		========================================================= */

		const grid =
			document.querySelector<HTMLElement>(
				'#works-grid'
			);


		if (!grid) {

			return;

		}


		/*
		 * 保存 photo.ts 原始顺序。
		 *
		 * 日期相同时，
		 * 保持原始作品顺序。
		 */

		const originalOrder =
			new Map(
				cards.map(
					(card, index) => [
						card,
						index,
					]
				)
			);


		const sortedCards =
			[...cards].sort(
				(a, b) => {

					const dateA =
						a.dataset.date ??
						'';


					const dateB =
						b.dataset.date ??
						'';


					const validA =
						isValidDateString(
							dateA
						);


					const validB =
						isValidDateString(
							dateB
						);


					/*
					 * 两个都没有有效日期：
					 * 保持原始顺序。
					 */

					if (
						!validA &&
						!validB
					) {

						return (
							(originalOrder.get(a) ?? 0) -
							(originalOrder.get(b) ?? 0)
						);

					}


					/*
					 * 无效日期放最后。
					 */

					if (!validA) {

						return 1;

					}


					if (!validB) {

						return -1;

					}


					/*
					 * 日期新的在前。
					 */

					const dateCompare =
						dateB.localeCompare(
							dateA
						);


					if (
						dateCompare !== 0
					) {

						return dateCompare;

					}


					/*
					 * 日期相同：
					 * 保持原始顺序。
					 */

					return (
						(originalOrder.get(a) ?? 0) -
						(originalOrder.get(b) ?? 0)
					);

				}
			);


		/*
		 * 将排序后的作品重新插入 Grid。
		 */

		sortedCards.forEach(
			(card) => {

				grid.appendChild(
					card
				);

			}
		);

	}


	/* =============================================================
	   DATE
	============================================================= */

	function getSelectedDate(): string {

		const year =
			dateYear?.value
				.trim()
				.replace(/\D/g, '') ??
			'';


		const month =
			dateMonth?.value
				.trim()
				.replace(/\D/g, '') ??
			'';


		const day =
			dateDay?.value
				.trim()
				.replace(/\D/g, '') ??
			'';


		if (
			year.length !== 4 ||
			month.length < 1 ||
			day.length < 1
		) {

			return '';

		}


		const monthNumber =
			Number(month);


		const dayNumber =
			Number(day);


		if (
			!Number.isFinite(monthNumber) ||
			monthNumber < 1 ||
			monthNumber > 12
		) {

			return '';

		}


		if (
			!Number.isFinite(dayNumber) ||
			dayNumber < 1 ||
			dayNumber > 31
		) {

			return '';

		}


		return (
			`${year}-${String(monthNumber).padStart(2, '0')}-${String(dayNumber).padStart(2, '0')}`
		);

	}


	function setDateValue(
		dateString: string
	) {

		const parts =
			dateString.split('-');


		if (dateYear) {

			dateYear.value =
				parts[0] ?? '';

		}


		if (dateMonth) {

			dateMonth.value =
				parts[1] ?? '';

		}


		if (dateDay) {

			dateDay.value =
				parts[2] ?? '';

		}

	}


	function clearDateValue() {

		if (dateYear) {

			dateYear.value =
				'';

		}


		if (dateMonth) {

			dateMonth.value =
				'';

		}


		if (dateDay) {

			dateDay.value =
				'';

		}

	}


	function normalizeDateFields() {

		if (dateYear) {

			dateYear.value =
				dateYear.value
					.replace(/\D/g, '')
					.slice(0, 4);

		}


		if (dateMonth) {

			const value =
				dateMonth.value
					.replace(/\D/g, '')
					.slice(0, 2);


			if (value) {

				const number =
					Math.min(
						12,
						Math.max(
							1,
							Number(value)
						)
					);


				dateMonth.value =
					String(number)
						.padStart(2, '0');

			}

		}


		if (dateDay) {

			const value =
				dateDay.value
					.replace(/\D/g, '')
					.slice(0, 2);


			if (value) {

				const number =
					Math.min(
						31,
						Math.max(
							1,
							Number(value)
						)
					);


				dateDay.value =
					String(number)
						.padStart(2, '0');

			}

		}

	}


	/* =============================================================
	   DATE INPUT FLOW
	   
	   Visual:
	   YYYY - MM - DD

	   Editing:
	   DD → MM → YYYY
	============================================================= */

	function bindDateInputFlow(
		input:
			HTMLInputElement | null,
		nextInput:
			HTMLInputElement | null,
		maxLength: number
	) {

		if (!input) {

			return;

		}


		input.addEventListener(
			'focus',
			() => {

				input.select();

			}
		);


		input.addEventListener(
			'input',
			() => {

				filtersActivated =
					true;


				input.value =
					input.value
						.replace(/\D/g, '')
						.slice(0, maxLength);


				if (
					input.value.length >=
						maxLength &&
					nextInput
				) {

					nextInput.focus();

				}


				currentPage =
					1;


				render();

			}
		);


		input.addEventListener(
			'change',
			() => {

				filtersActivated =
					true;


				normalizeDateFields();


				currentPage =
					1;


				render();

			}
		);


		input.addEventListener(
			'keydown',
			(event) => {

				if (
					event.key === 'Enter' ||
					event.key === 'ArrowRight'
				) {

					event.preventDefault();

					nextInput?.focus();

				}

			}
		);

	}


	bindDateInputFlow(
		dateDay,
		dateMonth,
		2
	);


	bindDateInputFlow(
		dateMonth,
		dateYear,
		2
	);


	bindDateInputFlow(
		dateYear,
		null,
		4
	);


	/* =============================================================
	   DATE BACKWARD FLOW
	============================================================= */

	dateMonth?.addEventListener(
		'keydown',
		(event) => {

			if (
				event.key ===
				'ArrowLeft'
			) {

				event.preventDefault();

				dateDay?.focus();

			}

		}
	);


	dateYear?.addEventListener(
		'keydown',
		(event) => {

			if (
				event.key ===
				'ArrowLeft'
			) {

				event.preventDefault();

				dateMonth?.focus();

			}

		}
	);


	/*
	 * 点击 DATE 区域的空白处：
	 * 从 DD 开始编辑。
	 */

	dateControl?.addEventListener(
		'click',
		(event) => {

			const target =
				event.target as HTMLElement;


			if (
				target === dateControl ||
				target.classList.contains(
					'date-segments'
				) ||
				target.classList.contains(
					'date-separator'
				)
			) {

				dateDay?.focus();

			}

		}
	);


	/* =============================================================
	   FILTERING
	============================================================= */

	function getFilteredCards() {

		/*
		 * 初始状态：
		 * 显示全部作品。
		 *
		 * 这里必须使用当前 DOM 顺序。
		 */

		if (!filtersActivated) {

			return getCardsInDomOrder();

		}


		const date =
			getSelectedDate();


		const people =
			peopleSelect?.value ??
			'all';


		const JINIES =
			JINIESSelect?.value ??
			'all';


		return getCardsInDomOrder().filter(
			(card) => {

				const dateMatch =
					!date ||
					card.dataset.date ===
						date;


				const peopleMatch =
					people === 'all' ||
					card.dataset.people ===
						people;


				const JINIESMatch =
					JINIES === 'all' ||
					card.dataset.JINIES ===
						JINIES;


				return (
					dateMatch &&
					peopleMatch &&
					JINIESMatch
				);

			}
		);

	}


	function getStatusText() {

		if (!filtersActivated) {

			return 'ALL WORKS';

		}


		const parts: string[] =
			[];


		const date =
			getSelectedDate();


		const people =
			peopleSelect?.value ??
			'all';


		const JINIES =
			JINIESSelect?.value ??
			'all';


		if (date) {

			parts.push(
				date
			);

		}


		if (
			people !== 'all'
		) {

			parts.push(
				people === '1'
					? '1 PERSON'
					: '2+ PEOPLE'
			);

		}


		if (
			JINIES !== 'all'
		) {

			parts.push(
				JINIES === 'yes'
					? 'WITH JINIES'
					: 'WITHOUT JINIES'
			);

		}


		return parts.length
			? parts.join(' / ')
			: 'ALL WORKS';

	}


	/* =============================================================
	   PAGINATION
	============================================================= */

	function createPageNumber(
		page: number,
		active: boolean
	) {

		const button =
			document.createElement(
				'button'
			);


		button.type =
			'button';


		button.className =
			active
				? 'page-number active'
				: 'page-number';


		button.textContent =
			String(page);


		button.setAttribute(
			'aria-label',
			`Go to page ${page}`
		);


		if (active) {

			button.setAttribute(
				'aria-current',
				'page'
			);

		}


		button.addEventListener(
			'click',
			() => {

				currentPage =
					page;


				render();


				scrollToGrid();

			}
		);


		return button;

	}


	function renderPageNumbers(
		totalPages: number
	) {

		if (!pageNumbers) {

			return;

		}


		pageNumbers.innerHTML =
			'';


		if (
			totalPages <= 7
		) {

			for (
				let page = 1;
				page <= totalPages;
				page += 1
			) {

				pageNumbers.appendChild(
					createPageNumber(
						page,
						page === currentPage
					)
				);

			}

			return;

		}


		pageNumbers.appendChild(
			createPageNumber(
				1,
				currentPage === 1
			)
		);


		if (
			currentPage > 3
		) {

			const ellipsis =
				document.createElement(
					'span'
				);


			ellipsis.className =
				'page-ellipsis';


			ellipsis.textContent =
				'···';


			pageNumbers.appendChild(
				ellipsis
			);

		}


		const start =
			Math.max(
				2,
				currentPage - 1
			);


		const end =
			Math.min(
				totalPages - 1,
				currentPage + 1
			);


		for (
			let page = start;
			page <= end;
			page += 1
		) {

			pageNumbers.appendChild(
				createPageNumber(
					page,
					page === currentPage
				)
			);

		}


		if (
			currentPage <
			totalPages - 2
		) {

			const ellipsis =
				document.createElement(
					'span'
				);


			ellipsis.className =
				'page-ellipsis';


			ellipsis.textContent =
				'···';


			pageNumbers.appendChild(
				ellipsis
			);

		}


		pageNumbers.appendChild(
			createPageNumber(
				totalPages,
				currentPage === totalPages
			)
		);

	}


	function render() {

		const filteredCards =
			getFilteredCards();


		const totalPages =
			Math.max(
				1,
				Math.ceil(
					filteredCards.length /
						PAGE_SIZE
				)
			);


		if (
			currentPage >
			totalPages
		) {

			currentPage =
				totalPages;

		}


		const start =
			(currentPage - 1) *
			PAGE_SIZE;


		const visibleCards =
			new Set(
				filteredCards.slice(
					start,
					start + PAGE_SIZE
				)
			);


		/*
		 * 按当前 DOM 顺序处理显示状态。
		 */

		getCardsInDomOrder().forEach(
			(card) => {

				card.style.display =
					visibleCards.has(card)
						? ''
						: 'none';

			}
		);


		if (resultCount) {

			resultCount.textContent =
				String(
					filteredCards.length
				);

		}


		if (resultStatus) {

			resultStatus.textContent =
				getStatusText();

		}


		const hasResults =
			filteredCards.length >
			0;


		if (emptyState) {

			emptyState.hidden =
				hasResults;

		}


		if (pagination) {

			pagination.hidden =
				!hasResults ||
				totalPages <= 1;

		}


		if (previousPage) {

			previousPage.disabled =
				!hasResults ||
				currentPage === 1;

		}


		if (nextPage) {

			nextPage.disabled =
				!hasResults ||
				currentPage === totalPages;

		}


		renderPageNumbers(
			totalPages
		);

	}


	function scrollToGrid() {

		document
			.querySelector(
				'#works-grid'
			)
			?.scrollIntoView({
				behavior: 'smooth',
				block: 'start',
			});

	}


	/* =============================================================
	   RESET
	============================================================= */

	function resetFilters() {

		setDateValue(
			DEFAULT_DATE
		);


		if (peopleSelect) {

			peopleSelect.value =
				'all';

		}


		if (JINIESSelect) {

			JINIESSelect.value =
				'all';

		}


		filtersActivated =
			false;


		currentPage =
			1;


		render();

	}


	/* =============================================================
	   FILTER EVENTS
	============================================================= */

	peopleSelect?.addEventListener(
		'change',
		() => {

			filtersActivated =
				true;


			currentPage =
				1;


			render();

		}
	);


	JINIESSelect?.addEventListener(
		'change',
		() => {

			filtersActivated =
				true;


			currentPage =
				1;


			render();

		}
	);


	clearDateButton?.addEventListener(
		'click',
		(event) => {

			event.stopPropagation();


			clearDateValue();


			filtersActivated =
				true;


			currentPage =
				1;


			render();

		}
	);


	resetButton?.addEventListener(
		'click',
		resetFilters
	);


	emptyReset?.addEventListener(
		'click',
		resetFilters
	);


	previousPage?.addEventListener(
		'click',
		() => {

			if (
				currentPage <= 1
			) {

				return;

			}


			currentPage -=
				1;


			render();


			scrollToGrid();

		}
	);


	nextPage?.addEventListener(
		'click',
		() => {

			const totalPages =
				Math.max(
					1,
					Math.ceil(
						getFilteredCards()
							.length /
							PAGE_SIZE
					)
				);


			if (
				currentPage >=
				totalPages
			) {

				return;

			}


			currentPage +=
				1;


			render();


			scrollToGrid();

		}
	);


	/* =============================================================
	   LIGHTBOX
	============================================================= */

	function collectLightboxItems() {

		/*
		 * 必须按照当前 DOM 顺序收集。
		 *
		 * 这样 Lightbox 的上一张 / 下一张
		 * 才会与 Exhibition 当前排序一致。
		 */

		const visibleCards =
			getCardsInDomOrder().filter(
				(card) =>
					card.style.display !==
					'none'
			);


		lightboxItems =
			visibleCards
				.map(
					(card) => {

						const trigger =
							card.querySelector<HTMLButtonElement>(
								'.lightbox-trigger'
							);


						if (!trigger) {

							return null;

						}


						return {
							src:
								trigger.dataset
									.lightboxSrc ??
								'',

							alt:
								trigger.dataset
									.lightboxAlt ??
								'',

							title:
								trigger.dataset
									.lightboxTitle ??
								'',

							/*
							 * 直接读取 card 当前 DATE。
							 *
							 * Admin 修改 DATE 后，
							 * 这里一定是最终 DATE。
							 */

							date:
								card.dataset.date ??
								'',
						};

					}
				)
				.filter(
					(item): item is {
						src: string;
						alt: string;
						title: string;
						date: string;
					} =>
						Boolean(item)
				);

	}


	function updateLightboxImage() {

		const item =
			lightboxItems[
				lightboxIndex
			];


		if (
			!item ||
			!lightboxImage
		) {

			return;

		}


		lightboxImage.src =
			item.src;


		lightboxImage.alt =
			item.alt;


		if (lightboxTitle) {

			lightboxTitle.textContent =
				item.title;

		}


		if (lightboxDate) {

			lightboxDate.textContent =
				item.date;

		}


		if (lightboxCounter) {

			lightboxCounter.textContent =
				`${String(
					lightboxIndex + 1
				).padStart(
					2,
					'0'
				)} / ${String(
					lightboxItems.length
				).padStart(
					2,
					'0'
				)}`;

		}


		const hasMultiple =
			lightboxItems.length >
			1;


		if (lightboxPrevious) {

			lightboxPrevious.hidden =
				!hasMultiple;


			lightboxPrevious.disabled =
				!hasMultiple;

		}


		if (lightboxNext) {

			lightboxNext.hidden =
				!hasMultiple;


			lightboxNext.disabled =
				!hasMultiple;

		}

	}


	function openLightbox(
		index: number
	) {

		if (
			!lightbox ||
			!lightboxItems.length
		) {

			return;

		}


		lastFocusedElement =
			document.activeElement instanceof
			HTMLElement
				? document.activeElement
				: null;


		lightboxIndex =
			Math.max(
				0,
				Math.min(
					index,
					lightboxItems.length - 1
				)
			);


		updateLightboxImage();


		lightbox.classList.add(
			'is-open'
		);


		lightbox.setAttribute(
			'aria-hidden',
			'false'
		);


		document.body.classList.add(
			'lightbox-open'
		);


		lightboxClose?.focus();

	}


	function closeLightbox() {

		if (!lightbox) {

			return;

		}


		lightbox.classList.remove(
			'is-open'
		);


		lightbox.setAttribute(
			'aria-hidden',
			'true'
		);


		document.body.classList.remove(
			'lightbox-open'
		);


		if (lightboxImage) {

			lightboxImage.removeAttribute(
				'src'
			);


			lightboxImage.alt =
				'';

		}


		lastFocusedElement?.focus();


		lastFocusedElement =
			null;

	}


	function showPrevious() {

		if (
			lightboxItems.length <=
			1
		) {

			return;

		}


		lightboxIndex =
			(
				lightboxIndex -
				1 +
				lightboxItems.length
			) %
			lightboxItems.length;


		updateLightboxImage();

	}


	function showNext() {

		if (
			lightboxItems.length <=
			1
		) {

			return;

		}


		lightboxIndex =
			(
				lightboxIndex +
				1
			) %
			lightboxItems.length;


		updateLightboxImage();

	}


	/* =============================================================
	   OPEN FROM CARD
	============================================================= */

	function openFromTrigger(
		trigger: HTMLButtonElement
	) {

		collectLightboxItems();


		/*
		 * 使用当前 DOM 顺序。
		 */

		const visibleTriggers =
			getCardsInDomOrder()
				.filter(
					(card) =>
						card.style.display !==
						'none'
				)
				.map(
					(card) =>
						card.querySelector<HTMLButtonElement>(
							'.lightbox-trigger'
						)
				)
				.filter(
					(item): item is HTMLButtonElement =>
						Boolean(item)
				);


		const clickedIndex =
			visibleTriggers.indexOf(
				trigger
			);


		openLightbox(
			clickedIndex >= 0
				? clickedIndex
				: 0
		);

	}


	/* =============================================================
	   LIGHTBOX CLICK EVENTS
	============================================================= */

	document.addEventListener(
		'click',
		(event) => {

			const target =
				event.target;


			if (
				!(
					target instanceof
					Element
				)
			) {

				return;

			}


			/*
			 * 点击图片。
			 */

			const trigger =
				target.closest<HTMLButtonElement>(
					'.lightbox-trigger'
				);


			if (trigger) {

				event.preventDefault();


				openFromTrigger(
					trigger
				);


				return;

			}


			/*
			 * 关闭按钮。
			 */

			if (
				target.closest(
					'#lightbox-close'
				)
			) {

				closeLightbox();


				return;

			}


			/*
			 * 上一张。
			 */

			if (
				target.closest(
					'#lightbox-prev'
				)
			) {

				showPrevious();


				return;

			}


			/*
			 * 下一张。
			 */

			if (
				target.closest(
					'#lightbox-next'
				)
			) {

				showNext();


				return;

			}


			/*
			 * 黑色背景。
			 */

			if (
				target.closest(
					'[data-lightbox-close]'
				)
			) {

				closeLightbox();

			}

		}
	);


	/* =============================================================
	   KEYBOARD
	============================================================= */

	document.addEventListener(
		'keydown',
		(event) => {

			if (
				!lightbox?.classList.contains(
					'is-open'
				)
			) {

				return;

			}


			if (
				event.key ===
				'Escape'
			) {

				event.preventDefault();


				closeLightbox();


				return;

			}


			if (
				event.key ===
				'ArrowLeft'
			) {

				event.preventDefault();


				showPrevious();


				return;

			}


			if (
				event.key ===
				'ArrowRight'
			) {

				event.preventDefault();


				showNext();

			}

		}
	);


	/* =============================================================
	   MOBILE SWIPE
	============================================================= */

	lightbox?.addEventListener(
		'touchstart',
		(event) => {

			touchStartX =
				event.changedTouches[0]
					?.clientX ??
				0;

		},
		{
			passive: true,
		}
	);


	lightbox?.addEventListener(
		'touchend',
		(event) => {

			const endX =
				event.changedTouches[0]
					?.clientX ??
				0;


			const deltaX =
				endX -
				touchStartX;


			if (
				Math.abs(deltaX) <
				50
			) {

				return;

			}


			if (
				deltaX < 0
			) {

				showNext();

			} else {

				showPrevious();

			}

		},
		{
			passive: true,
		}
	);


	/* =============================================================
	   STORAGE REFRESH
	============================================================= */

	function refreshFromStorage() {

		/*
		 * 重新读取 Admin 数据。
		 *
		 * applyMetadata() 会同时：
		 *
		 * 1. 更新 ROCO
		 * 2. 更新 JINIES
		 * 3. 更新 DATE
		 * 4. 按最终 DATE 重新排序
		 * 5. 同步 Lightbox DATE
		 */

		applyMetadata();


		currentPage =
			1;


		render();

	}


	window.addEventListener(
		'storage',
		(event) => {

			if (
				event.key ===
				STORAGE_KEY
			) {

				refreshFromStorage();

			}

		}
	);


	window.addEventListener(
		'pageshow',
		refreshFromStorage
	);


	document.addEventListener(
		'astro:page-load',
		() => {

			refreshFromStorage();

		}
	);


	/* =============================================================
	   INITIAL
	============================================================= */

	applyMetadata();


	render();
</script>


