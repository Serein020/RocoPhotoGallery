---
import Layout from '../layouts/Layout.astro';

import { photoWorks } from '../data/photo';

const photos = photoWorks;
---

<Layout title="ADMIN — ROCO PHOTO GALLERY">
	<main class="admin-page">

		<header class="admin-header">

			<div class="admin-brand">

				<a
					href="/"
					class="brand-name"
				>
					ROCO
				</a>

				<span class="brand-caption">
					PHOTO GALLERY / ADMIN
				</span>

			</div>


			<div class="admin-header-actions">

				<a
					href="/exhibition/"
					class="header-link"
				>
					EXHIBITION
				</a>

				<button
					type="button"
					class="save-button"
					id="save-draft"
				>
					SAVE
				</button>

			</div>

		</header>


		<section class="admin-intro">

			<div class="intro-copy">

				<p class="eyebrow">
					PHOTO METADATA
				</p>

				<h1>
					ADMIN
				</h1>

				<p class="intro-description">
					Edit photo date, people count and JINIES status.
				</p>

			</div>


			<div class="admin-meta">

				<div class="meta-item">

					<span class="meta-label">
						PHOTOS
					</span>

					<strong>
						{photos.length}
					</strong>

				</div>


				<div class="meta-item">

					<span class="meta-label">
						STATUS
					</span>

					<strong id="draft-status">
						READY
					</strong>

				</div>

			</div>

		</section>


		<section class="progress-section">

			<div class="progress-top">

				<span>
					COMPLETION
				</span>

				<strong id="progress-number">
					0%
				</strong>

			</div>


			<div class="progress-track">

				<div
					class="progress-fill"
					id="progress-fill"
				></div>

			</div>

		</section>


		<section class="toolbar">

			<div class="keyboard-hints">
				<span>
					0 = 0
				</span>

				<span>
					1 = 1
				</span>

				<span>
					2 = 2
				</span>

				<span>
					3 = 2+
				</span>

				<span>
					R = JINIES
				</span>

				<span>
					← →
				</span>

			</div>


			<div class="toolbar-actions">

				<button
					type="button"
					class="toolbar-button"
					id="clear-draft"
				>
					CLEAR
				</button>

				<button
					type="button"
					class="toolbar-button"
					id="export-json"
				>
					EXPORT JSON
				</button>

			</div>

		</section>


		<section class="photo-grid">

			{photos.map((photo) => (

				<article
					class="photo-card"
					data-id={photo.id}
				>

					<div class="photo-card-image">

						<img
							src={photo.image}
							alt={photo.id}
							loading="lazy"
							decoding="async"
						/>

						<span class="photo-card-index">
							{String(photo.order).padStart(3, '0')}
						</span>

					</div>


					<div class="photo-card-body">

						<div class="photo-card-heading">

							<strong>
								{photo.id}
							</strong>

							<span class="card-status">
								<span class="status-dot"></span>
								<span class="status-text">
									READY
								</span>
							</span>

						</div>


						<div class="field-group">

							<label
								for={`date-${photo.id}`}
							>
								DATE
							</label>

							<input
								id={`date-${photo.id}`}
								class="date-input"
								type="date"
								data-field="date"
								data-original-date={photo.date}
								value={photo.date}
							/>

						</div>


						<div class="field-group">

							<span class="field-label">
								PEOPLE
							</span>

							<div class="choice-row">
								<button
									type="button"
									class="choice-button"
									data-field="people"
									data-value="0"
								>
									0
								</button>

								<button
									type="button"
									class="choice-button"
									data-field="people"
									data-value="1"
								>
									1
								</button>

								<button
									type="button"
									class="choice-button"
									data-field="people"
									data-value="2"
								>
									2
								</button>

								<button
									type="button"
									class="choice-button"
									data-field="people"
									data-value="3"
								>
									2+
								</button>

							</div>

						</div>


						<div class="field-group">

							<span class="field-label">
								JINIES
							</span>

							<div class="choice-row">

								<button
									type="button"
									class="choice-button"
									data-field="JINIES"
									data-value="no"
								>
									NO
								</button>

								<button
									type="button"
									class="choice-button"
									data-field="JINIES"
									data-value="yes"
								>
									YES
								</button>

							</div>

						</div>

					</div>

				</article>

			))}

		</section>


		<nav class="quick-nav">

			<button
				type="button"
				class="nav-button"
				id="prev-card"
			>
				← PREV
			</button>

			<button
				type="button"
				class="nav-button"
				id="next-card"
			>
				NEXT →
			</button>

		</nav>


		<footer class="admin-footer">

			<span>
				ROCO PHOTO GALLERY
			</span>

			<span>
				LOCAL METADATA / V1
			</span>

		</footer>

	</main>
</Layout>


<script is:inline>
  const STORAGE_KEY = 'roco-photo-admin-draft-v1';

  const cards = Array.from(
    document.querySelectorAll('.photo-card')
  );

  const dirtyCards = new Set();

  let statusTimer = null;
  let focusedCardIndex = 0;

  function readStore() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);

      if (!raw) return {};

      const parsed = JSON.parse(raw);

      if (
        parsed &&
        typeof parsed === 'object' &&
        !Array.isArray(parsed)
      ) {
        return parsed;
      }

      /*
       * 兼容旧版本：
       * 如果 localStorage 里还是数组，
       * 这里自动转换成 object。
       */
      if (Array.isArray(parsed)) {
        const store = {};

        for (const item of parsed) {
          if (item && typeof item.id === 'string') {
            store[item.id] = item;
          }
        }

        return store;
      }
    } catch (error) {
      console.warn(
        '[ROCO ADMIN] Failed to read localStorage:',
        error
      );
    }

    return {};
  }

  function getImageSource(card) {
    const image = card.querySelector('img');

    if (image) {
      const src = image.getAttribute('src');

      if (src) {
        return src;
      }
    }

    const id = card.dataset.id || '';

    return `/photos/pics/${id}.png`;
  }

  function getCardData(card) {
    const id = card.dataset.id || '';

    if (!id) {
      return null;
    }

    const dateInput = card.querySelector('.date-input');

    const activePeople = card.querySelector(
      '.choice-button[data-field="people"].active'
    );

    const activeJINIES = card.querySelector(
      '.choice-button[data-field="JINIES"].active'
    );

    let people = null;

    if (activePeople) {
      const value = activePeople.dataset.value;

      if (value === '1') {
        people = 1;
      } else if (value === '2') {
        people = 2;
      } else if (value === '3') {
        people = 3;
      }
    }

    let JINIES = null;

    if (activeJINIES) {
      const value = activeJINIES.dataset.value;

      if (value === 'yes') {
        JINIES = true;
      } else if (value === 'no') {
        JINIES = false;
      }
    }

    return {
      id,
      image: getImageSource(card),
      date: dateInput ? dateInput.value : '',
      people,
      JINIES
    };
  }

  function updateProgress() {
    const progressNumber =
      document.querySelector('#progress-number');

    const progressFill =
      document.querySelector('#progress-fill');

    let complete = 0;

    for (const card of cards) {
      const data = getCardData(card);

      if (
        data &&
        data.date &&
        data.people !== null &&
        data.JINIES !== null
      ) {
        complete += 1;
      }
    }

    const total = cards.length;

    const percent =
      total > 0
        ? Math.round((complete / total) * 100)
        : 0;

    if (progressNumber) {
      progressNumber.textContent = `${percent}%`;
    }

    if (progressFill) {
      progressFill.style.width = `${percent}%`;
    }

    for (const card of cards) {
      const data = getCardData(card);

      const completeCard = Boolean(
        data &&
        data.date &&
        data.people !== null &&
        data.JINIES !== null
      );

      const dot = card.querySelector('.status-dot');
      const text = card.querySelector('.status-text');

      if (dot) {
        dot.classList.toggle(
          'complete',
          completeCard
        );
      }

      if (text) {
        text.textContent =
          completeCard ? 'DONE' : 'READY';
      }
    }
  }

  function showStatus(message) {
    const status =
      document.querySelector('#draft-status');

    if (!status) {
      return;
    }

    status.textContent = message;

    if (statusTimer) {
      clearTimeout(statusTimer);
    }

    statusTimer = setTimeout(function () {
      status.textContent = 'READY';
    }, 1800);
  }

  function saveDraft(message) {
    if (!message) {
      message = 'SAVED';
    }

    const existingStore = readStore();

    for (const id of dirtyCards) {
      const card = cards.find(function (item) {
        return item.dataset.id === id;
      });

      if (!card) {
        continue;
      }

      const data = getCardData(card);

      if (!data) {
        continue;
      }

      existingStore[id] = data;
    }

    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify(existingStore)
      );

      dirtyCards.clear();

      showStatus(message);
      updateProgress();

      console.log(
        '[ROCO ADMIN] Saved:',
        existingStore
      );
    } catch (error) {
      console.error(
        '[ROCO ADMIN] Failed to save:',
        error
      );

      showStatus('ERROR');
    }
  }

  function markCardDirty(card) {
    const id = card.dataset.id || '';

    if (!id) {
      return;
    }

    dirtyCards.add(id);

    updateProgress();
  }

  function setChoice(card, field, value) {
    const buttons = card.querySelectorAll(
      `.choice-button[data-field="${field}"]`
    );

    buttons.forEach(function (button) {
      button.classList.toggle(
        'active',
        button.dataset.value === value
      );
    });

    markCardDirty(card);

    saveDraft('SAVED');
  }

  function setChoiceWithoutSave(
    card,
    field,
    value
  ) {
    const buttons = card.querySelectorAll(
      `.choice-button[data-field="${field}"]`
    );

    buttons.forEach(function (button) {
      button.classList.toggle(
        'active',
        button.dataset.value === value
      );
    });
  }

  function loadDraft() {
    const store = readStore();

    for (const card of cards) {
      const id = card.dataset.id || '';

      if (!id) {
        continue;
      }

      const saved = store[id];

      if (!saved) {
        continue;
      }

      const dateInput =
        card.querySelector('.date-input');

      if (
        dateInput &&
        typeof saved.date === 'string'
      ) {
        dateInput.value = saved.date;
      }

      if (saved.people === 1) {
        setChoiceWithoutSave(
          card,
          'people',
          '1'
        );
      } else if (saved.people === 2) {
        setChoiceWithoutSave(
          card,
          'people',
          '2'
        );
      } else if (
        typeof saved.people === 'number' &&
        saved.people >= 3
      ) {
        setChoiceWithoutSave(
          card,
          'people',
          '3'
        );
      }

      if (saved.JINIES === true) {
        setChoiceWithoutSave(
          card,
          'JINIES',
          'yes'
        );
      } else if (saved.JINIES === false) {
        setChoiceWithoutSave(
          card,
          'JINIES',
          'no'
        );
      }
    }

    dirtyCards.clear();

    updateProgress();

    console.log(
      '[ROCO ADMIN] Draft loaded:',
      store
    );
  }

  function clearDraft() {
    const confirmed = window.confirm(
      'Clear all saved metadata?'
    );

    if (!confirmed) {
      return;
    }

    localStorage.removeItem(STORAGE_KEY);

    dirtyCards.clear();

    for (const card of cards) {
      const dateInput =
        card.querySelector('.date-input');

      if (dateInput) {
        dateInput.value =
          dateInput.dataset.originalDate || '';
      }

      const buttons =
        card.querySelectorAll('.choice-button');

      buttons.forEach(function (button) {
        button.classList.remove('active');
      });
    }

    updateProgress();

    showStatus('CLEARED');
  }

  function exportData() {
    if (dirtyCards.size > 0) {
      saveDraft('SAVED');
    }

    const store = readStore();

    const completeData =
      Object.values(store).filter(
        function (item) {
          return (
            item &&
            item.id &&
            item.date &&
            item.people !== null &&
            item.JINIES !== null
          );
        }
      );

    const blob = new Blob(
      [
        JSON.stringify(
          completeData,
          null,
          2
        )
      ],
      {
        type: 'application/json'
      }
    );

    const url =
      URL.createObjectURL(blob);

    const link =
      document.createElement('a');

    link.href = url;

    link.download =
      'roco-photo-metadata.json';

    document.body.appendChild(link);

    link.click();

    link.remove();

    URL.revokeObjectURL(url);

    showStatus('EXPORTED');
  }

  function focusCard(index) {
    if (cards.length === 0) {
      return;
    }

    focusedCardIndex =
      Math.max(
        0,
        Math.min(
          index,
          cards.length - 1
        )
      );

    const card =
      cards[focusedCardIndex];

    if (!card) {
      return;
    }

    card.scrollIntoView({
      behavior: 'smooth',
      block: 'center'
    });

    const input =
      card.querySelector('.date-input');

    if (input) {
      input.focus();
    }
  }

  const saveButton =
    document.querySelector('#save-draft');

  if (saveButton) {
    saveButton.addEventListener(
      'click',
      function () {
        saveDraft('SAVED');
      }
    );
  }

  const clearButton =
    document.querySelector('#clear-draft');

  if (clearButton) {
    clearButton.addEventListener(
      'click',
      clearDraft
    );
  }

  const exportButton =
    document.querySelector('#export-json');

  if (exportButton) {
    exportButton.addEventListener(
      'click',
      exportData
    );
  }

  for (const card of cards) {
    const buttons =
      card.querySelectorAll(
        '.choice-button'
      );

    buttons.forEach(function (button) {
      button.addEventListener(
        'click',
        function (event) {
          event.preventDefault();

          const field =
            button.dataset.field;

          const value =
            button.dataset.value;

          if (!field || !value) {
            return;
          }

          setChoice(
            card,
            field,
            value
          );
        }
      );
    });

    const dateInput =
      card.querySelector('.date-input');

    if (dateInput) {
      dateInput.dataset.originalDate =
        dateInput.value;

      dateInput.addEventListener(
        'change',
        function () {
          markCardDirty(card);

          saveDraft('SAVED');
        }
      );
    }
  }

  const prevButton =
    document.querySelector('#prev-card');

  if (prevButton) {
    prevButton.addEventListener(
      'click',
      function () {
        focusCard(
          focusedCardIndex - 1
        );
      }
    );
  }

  const nextButton =
    document.querySelector('#next-card');

  if (nextButton) {
    nextButton.addEventListener(
      'click',
      function () {
        focusCard(
          focusedCardIndex + 1
        );
      }
    );
  }

  document.addEventListener(
    'keydown',
    function (event) {
      const target = event.target;

      if (
        target &&
        target.tagName === 'INPUT' &&
        target.type === 'date' &&
        (
          event.key === 'ArrowLeft' ||
          event.key === 'ArrowRight'
        )
      ) {
        return;
      }

      const card =
        cards[focusedCardIndex];

      if (!card) {
        return;
      }

      if (event.key === '1') {
        event.preventDefault();

        const button =
          card.querySelector(
            '.choice-button[data-field="people"][data-value="1"]'
          );

        if (button) {
          button.click();
        }

        return;
      }

      if (event.key === '2') {
        event.preventDefault();

        const button =
          card.querySelector(
            '.choice-button[data-field="people"][data-value="2"]'
          );

        if (button) {
          button.click();
        }

        return;
      }

      if (event.key === '3') {
        event.preventDefault();

        const button =
          card.querySelector(
            '.choice-button[data-field="people"][data-value="3"]'
          );

        if (button) {
          button.click();
        }

        return;
      }

      if (
        event.key.toLowerCase() === 'r'
      ) {
        event.preventDefault();

        const active =
          card.querySelector(
            '.choice-button[data-field="JINIES"].active'
          );

        const yesButton =
          card.querySelector(
            '.choice-button[data-field="JINIES"][data-value="yes"]'
          );

        const noButton =
          card.querySelector(
            '.choice-button[data-field="JINIES"][data-value="no"]'
          );

        if (active === yesButton) {
          if (noButton) {
            noButton.click();
          }
        } else {
          if (yesButton) {
            yesButton.click();
          }
        }

        return;
      }

      if (event.key === 'ArrowLeft') {
        event.preventDefault();

        focusCard(
          focusedCardIndex - 1
        );

        return;
      }

      if (event.key === 'ArrowRight') {
        event.preventDefault();

        focusCard(
          focusedCardIndex + 1
        );
      }
    }
  );

  loadDraft();

  updateProgress();

  console.log(
    '[ROCO ADMIN] Initialized.',
    {
      cards: cards.length,
      storageKey: STORAGE_KEY
    }
  );
</script>


<style>

	:global(html) {
		background:
			#f3ca36;
	}


	:global(body) {
		margin: 0;

		background:
			#f4efe4;

		color:
			#171717;

		font-family:
			Arial,
			Helvetica,
			sans-serif;
	}


	.admin-page {
		width:
			min(
				1200px,
				calc(
					100% - 48px
				)
			);

		margin:
			0 auto;

		padding:
			32px 0 70px;
	}


	.admin-header {
		display: flex;

		align-items:
			flex-start;

		justify-content:
			space-between;

		gap: 30px;

		padding-bottom:
			32px;

		border-bottom:
			1.5px solid
			rgba(
				23,
				23,
				23,
				0.22
			);
	}


	.admin-brand {
		display: flex;

		flex-direction:
			column;

		gap: 5px;
	}


	.brand-name {
		color:
			#171717;

		font-size:
			25px;

		font-weight:
			950;

		letter-spacing:
			-0.07em;

		line-height:
			0.9;

		text-decoration:
			none;
	}


	.brand-caption {
		font-size:
			8px;

		font-weight:
			800;

		letter-spacing:
			0.18em;

		opacity:
			0.45;
	}


	.admin-header-actions {
		display: flex;

		align-items:
			center;

		gap:
			18px;
	}


	.header-link {
		color:
			#171717;

		font-size:
			9px;

		font-weight:
			900;

		letter-spacing:
			0.12em;

		text-decoration:
			none;

		opacity:
			0.55;
	}


	.header-link:hover {
		opacity:
			1;
	}


	.save-button {
		height:
			42px;

		padding:
			0 20px;

		border:
			2px solid
			#171717;

		border-radius:
			8px;

		background:
			#171717;

		color:
			#fff8e8;

		font-size:
			9px;

		font-weight:
			900;

		letter-spacing:
			0.13em;

		cursor:
			pointer;
	}


	.admin-intro {
		display: flex;

		align-items:
			flex-end;

		justify-content:
			space-between;

		gap:
			30px;

		padding:
			55px 0 30px;
	}


	.intro-copy {
		max-width:
			680px;
	}


	.eyebrow {
		margin:
			0 0 9px;

		font-size:
			8px;

		font-weight:
			900;

		letter-spacing:
			0.18em;

		opacity:
			0.45;
	}


	.intro-copy h1 {
		margin:
			0 0 10px;

		font-size:
			clamp(
				42px,
				7vw,
				78px
			);

		font-weight:
			950;

		letter-spacing:
			-0.07em;

		line-height:
			0.9;
	}


	.intro-description {
		margin:
			0;

		font-size:
			10px;

		font-weight:
			700;

		letter-spacing:
			0.04em;

		opacity:
			0.48;
	}


	.admin-meta {
		display: flex;

		gap:
			35px;
	}


	.meta-item {
		display: flex;

		flex-direction:
			column;

		gap:
			5px;
	}


	.meta-label {
		font-size:
			8px;

		font-weight:
			900;

		letter-spacing:
			0.15em;

		opacity:
			0.42;
	}


	.meta-item strong {
		font-size:
			25px;

		font-weight:
			950;

